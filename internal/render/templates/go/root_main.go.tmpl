{{- $interactiveOAuth := and (appUsesOAuth2 .App) .RuntimeBundle (eq .RuntimeBundle.OAuth2GrantType "authorization_code") -}}
package main

import (
	"os"

	"github.com/spf13/cobra"

	{{- if $interactiveOAuth }}
	"{{ .Module }}/internal/auth"
	{{- end }}
	"{{ .Module }}/internal/cli"
	"{{ .Module }}/internal/httpx"
{{- range .App.Groups }}
	{{- if not (and $interactiveOAuth (eq (groupPackageName .) "auth")) }}
	{{ groupPackageName . }} "{{ $.Module }}/internal/{{ groupPackageName . }}"
	{{- end }}
{{- end }}
)

var version = {{ printf "%q" (goAppVersion .App) }}

func main() {
	cobra.EnableCommandSorting = false
	root := cli.NewRootCommand("{{ .App.Name }}", "{{ .App.Name }} CLI", version)
	cli.BindTrace(httpx.SetTraceEnabled)
	{{- if $interactiveOAuth }}
root.AddCommand(auth.NewOAuth2LoginCommand("{{ .App.Name }}"), auth.NewOAuth2StatusCommand("{{ .App.Name }}"), auth.NewOAuth2LogoutCommand("{{ .App.Name }}"))
	{{- end }}
{{- range .App.Groups }}
	root.AddCommand({{ groupPackageName . }}.NewCommand())
{{- end }}
	root.AddCommand(cli.NewSkillsCommand())
	cli.ApplyRootHelp(root)
	os.Exit(cli.ExecuteRoot(root))
}
