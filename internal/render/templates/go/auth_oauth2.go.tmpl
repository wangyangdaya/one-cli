func NewOAuth2LoginCommand(appName string) *cobra.Command {
	var noBrowser bool
	cmd := &cobra.Command{
		Use:   "login",
		Short: "Log in with OAuth2 authorization code",
		RunE: func(cmd *cobra.Command, args []string) error {
			return loginAuthorizationCode(cmd, appName, noBrowser)
		},
	}
	cmd.Flags().BoolVar(&noBrowser, "no-browser", false, "Print the login URL without opening a browser")
	return cmd
}

func NewOAuth2LogoutCommand(appName string) *cobra.Command {
	return &cobra.Command{
		Use:   "logout",
		Short: "Delete the stored OAuth2 session",
		RunE: func(cmd *cobra.Command, args []string) error {
			if err := config.ClearOAuthAuthorizationToken(appName); err != nil {
				return err
			}
			_, err := fmt.Fprintln(cmd.OutOrStdout(), "logged out")
			return err
		},
	}
}

func NewOAuth2StatusCommand(appName string) *cobra.Command {
	return &cobra.Command{
		Use:   "status",
		Short: "Show the stored OAuth2 session status",
		RunE: func(cmd *cobra.Command, args []string) error {
			status, err := config.OAuthAuthorizationStatus(appName)
			if err != nil {
				return err
			}
			_, err = fmt.Fprintln(cmd.OutOrStdout(), status)
			return err
		},
	}
}

func loginAuthorizationCode(cmd *cobra.Command, appName string, noBrowser bool) error {
	auth, err := config.LoadOAuthAuthorizationConfig(appName)
	if err != nil {
		return err
	}
	listenAddress := "127.0.0.1:0"
	callbackPath := "/oauth/callback"
	redirectURI := ""
	if auth.RedirectURI != "" {
		configured, parseErr := url.Parse(auth.RedirectURI)
		if parseErr != nil || configured.Host == "" || configured.Path == "" {
			return fmt.Errorf("invalid OAuth redirect_uri")
		}
		listenAddress = configured.Host
		callbackPath = configured.Path
		redirectURI = auth.RedirectURI
	}
	listener, err := net.Listen("tcp4", listenAddress)
	if err != nil {
		return fmt.Errorf("start OAuth callback listener: %w", err)
	}
	defer listener.Close()

	if redirectURI == "" {
		redirectURI = "http://" + listener.Addr().String() + callbackPath
	}
	state, err := randomValue(32)
	if err != nil {
		return err
	}
	authorizeURL, err := buildAuthorizeURL(auth, redirectURI, state)
	if err != nil {
		return err
	}

	type callbackResult struct {
		code string
		err  error
	}
	result := make(chan callbackResult, 1)
	mux := http.NewServeMux()
	mux.HandleFunc(callbackPath, func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Query().Get("state") != state {
			http.Error(w, "invalid OAuth state", http.StatusBadRequest)
			select {
			case result <- callbackResult{err: fmt.Errorf("OAuth callback state mismatch")}:
			default:
			}
			return
		}
		if oauthError := strings.TrimSpace(r.URL.Query().Get("error")); oauthError != "" {
			http.Error(w, "OAuth authorization was denied", http.StatusBadRequest)
			select {
			case result <- callbackResult{err: fmt.Errorf("OAuth authorization failed: %s", oauthError)}:
			default:
			}
			return
		}
		code := strings.TrimSpace(r.URL.Query().Get("code"))
		if code == "" {
			http.Error(w, "missing authorization code", http.StatusBadRequest)
			select {
			case result <- callbackResult{err: fmt.Errorf("OAuth callback is missing code")}:
			default:
			}
			return
		}
		_, _ = io.WriteString(w, "Login completed. You may close this window.")
		select {
		case result <- callbackResult{code: code}:
		default:
		}
	})
	server := &http.Server{Handler: mux, ReadHeaderTimeout: 5 * time.Second}
	go func() { _ = server.Serve(listener) }()

	if _, err := fmt.Fprintln(cmd.OutOrStdout(), authorizeURL); err != nil {
		return err
	}
	if !noBrowser {
		if err := openBrowser(authorizeURL); err != nil {
			return fmt.Errorf("open browser: %w", err)
		}
	}

	var callback callbackResult
	select {
	case callback = <-result:
	case <-time.After(2 * time.Minute):
		return fmt.Errorf("OAuth login timed out")
	}
	shutdownContext, cancelShutdown := context.WithTimeout(context.Background(), time.Second)
	_ = server.Shutdown(shutdownContext)
	cancelShutdown()
	if callback.err != nil {
		return callback.err
	}
	token, err := exchangeAuthorizationCode(auth, callback.code, state, redirectURI)
	if err != nil {
		return err
	}
	if err := config.SaveOAuthAuthorizationToken(appName, token); err != nil {
		return err
	}
	_, err = fmt.Fprintln(cmd.OutOrStdout(), "login successful")
	return err
}

func buildAuthorizeURL(auth config.OAuthAuthorizationConfig, redirectURI, state string) (string, error) {
	endpoint, err := url.Parse(auth.AuthorizationURL)
	if err != nil || endpoint.Scheme == "" || endpoint.Host == "" {
		return "", fmt.Errorf("invalid OAuth authorization_url")
	}
	query := endpoint.Query()
	query.Set("client_id", auth.ClientID)
	query.Set("redirect_uri", redirectURI)
	query.Set("response_type", "code")
	query.Set("state", state)
	if len(auth.Scopes) > 0 {
		query.Set("scope", strings.Join(auth.Scopes, " "))
	}
	endpoint.RawQuery = query.Encode()
	return endpoint.String(), nil
}

func exchangeAuthorizationCode(auth config.OAuthAuthorizationConfig, code, state, redirectURI string) (config.OAuthTokenResponse, error) {
	method := http.MethodPost
	endpoint, err := url.Parse(auth.TokenURL)
	if err != nil || endpoint.Scheme == "" || endpoint.Host == "" {
		return config.OAuthTokenResponse{}, fmt.Errorf("invalid OAuth token_url")
	}
	form := url.Values{}
	requestHeaders := http.Header{}
	cookies := make([]*http.Cookie, 0)
	var body io.Reader
	if auth.TokenExchange == nil {
		form.Set("grant_type", "authorization_code")
		form.Set("client_id", auth.ClientID)
		form.Set("code", code)
		form.Set("redirect_uri", redirectURI)
		body = strings.NewReader(form.Encode())
		requestHeaders.Set("Content-Type", "application/x-www-form-urlencoded")
	} else {
		exchange := auth.TokenExchange
		method = strings.ToUpper(strings.TrimSpace(exchange.Method))
		if method == "" {
			method = http.MethodPost
		}
		bodyValues := make(map[string]string)
		query := endpoint.Query()
		for _, parameter := range exchange.Parameters {
			value := tokenExchangeSourceValue(parameter, code, state, auth, redirectURI)
			if strings.TrimSpace(value) == "" {
				if parameter.Required {
					return config.OAuthTokenResponse{}, fmt.Errorf("OAuth token exchange parameter %q is required", parameter.Name)
				}
				continue
			}
			switch strings.ToLower(strings.TrimSpace(parameter.In)) {
			case "body":
				bodyValues[parameter.Name] = value
			case "query":
				query.Set(parameter.Name, value)
			case "header":
				requestHeaders.Set(parameter.Name, value)
			case "cookie":
				cookies = append(cookies, &http.Cookie{Name: parameter.Name, Value: value})
			}
		}
		endpoint.RawQuery = query.Encode()
		switch strings.ToLower(strings.TrimSpace(exchange.BodyFormat)) {
		case "json":
			payload, marshalErr := json.Marshal(bodyValues)
			if marshalErr != nil {
				return config.OAuthTokenResponse{}, fmt.Errorf("encode OAuth token exchange request: %w", marshalErr)
			}
			body = bytes.NewReader(payload)
			requestHeaders.Set("Content-Type", "application/json")
		case "form":
			for name, value := range bodyValues {
				form.Set(name, value)
			}
			body = strings.NewReader(form.Encode())
			requestHeaders.Set("Content-Type", "application/x-www-form-urlencoded")
		}
	}
	req, err := http.NewRequest(method, endpoint.String(), body)
	if err != nil {
		return config.OAuthTokenResponse{}, fmt.Errorf("build OAuth token request: %w", err)
	}
	req.Header = requestHeaders
	for _, cookie := range cookies {
		req.AddCookie(cookie)
	}
	format := "form"
	if auth.TokenExchange != nil && strings.TrimSpace(auth.TokenExchange.BodyFormat) != "" {
		format = strings.ToLower(strings.TrimSpace(auth.TokenExchange.BodyFormat))
	}
	httpx.Tracef("[opencli][oauth] token_exchange\n  method: %s\n  url: %s://%s%s\n  format: %s", method, endpoint.Scheme, endpoint.Host, endpoint.Path, format)
	resp, err := (&http.Client{Timeout: 30 * time.Second}).Do(req)
	if err != nil {
		return config.OAuthTokenResponse{}, fmt.Errorf("request business login endpoint: %w", err)
	}
	defer resp.Body.Close()
	httpx.Tracef("[opencli][oauth] token_exchange_response\n  status: %d", resp.StatusCode)
	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
		errorBytes, readErr := io.ReadAll(io.LimitReader(resp.Body, 4096))
		if readErr != nil || strings.TrimSpace(string(errorBytes)) == "" {
			return config.OAuthTokenResponse{}, fmt.Errorf("business login endpoint returned %s", resp.Status)
		}
		return config.OAuthTokenResponse{}, fmt.Errorf("business login endpoint returned %s: %s", resp.Status, strings.TrimSpace(string(errorBytes)))
	}
	bodyBytes, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	if err != nil {
		return config.OAuthTokenResponse{}, fmt.Errorf("read business token response: %w", err)
	}
	var bodyValue any
	decoder := json.NewDecoder(bytes.NewReader(bodyBytes))
	decoder.UseNumber()
	if err := decoder.Decode(&bodyValue); err != nil {
		return config.OAuthTokenResponse{}, fmt.Errorf("decode business token response: %w", err)
	}
	accessMapping := exchangeResultMapping(auth.TokenExchange, "access_token")
	tokenTypeMapping := exchangeResultMapping(auth.TokenExchange, "token_type")
	expiresMapping := exchangeResultMapping(auth.TokenExchange, "expires_in")
	refreshMapping := exchangeResultMapping(auth.TokenExchange, "refresh_token")
	refreshExpiresMapping := exchangeResultMapping(auth.TokenExchange, "refresh_token_expires_in")
	scopeMapping := exchangeResultMapping(auth.TokenExchange, "scope")
	accessToken := strings.TrimSpace(exchangeResponseString(resp.Header, bodyValue, accessMapping))
	refreshToken := strings.TrimSpace(exchangeResponseString(resp.Header, bodyValue, refreshMapping))
	tokenType := strings.TrimSpace(exchangeResponseString(resp.Header, bodyValue, tokenTypeMapping))
	scope := strings.TrimSpace(exchangeResponseString(resp.Header, bodyValue, scopeMapping))
	expiresIn, err := exchangeResponseInt64(resp.Header, bodyValue, expiresMapping)
	if err != nil {
		return config.OAuthTokenResponse{}, err
	}
	refreshExpiresIn, err := exchangeResponseInt64(resp.Header, bodyValue, refreshExpiresMapping)
	if err != nil {
		return config.OAuthTokenResponse{}, err
	}
	if accessToken == "" {
		return config.OAuthTokenResponse{}, fmt.Errorf("business token response is missing access_token")
	}
	if tokenType != "" && !strings.EqualFold(tokenType, "bearer") {
		return config.OAuthTokenResponse{}, fmt.Errorf("unsupported business token_type %q", tokenType)
	}
	return config.OAuthTokenResponse{
		AccessToken: accessToken, RefreshToken: refreshToken, TokenType: tokenType,
		Scope: scope, ExpiresIn: expiresIn, RefreshTokenExpiresIn: refreshExpiresIn,
	}, nil
}

func tokenExchangeSourceValue(parameter config.OAuthTokenExchangeParameter, code, state string, auth config.OAuthAuthorizationConfig, redirectURI string) string {
	switch strings.ToLower(strings.TrimSpace(parameter.Source)) {
	case "code":
		return code
	case "state":
		return state
	case "client_id":
		return auth.ClientID
	case "redirect_uri":
		return redirectURI
	case "scope":
		return strings.Join(auth.Scopes, " ")
	case "grant_type":
		return "authorization_code"
	case "literal":
		return parameter.Value
	default:
		return ""
	}
}

func exchangeResultMapping(exchange *config.OAuthTokenExchangeConfig, name string) config.OAuthTokenExchangeResult {
	result := config.OAuthTokenExchangeResult{In: "body", Path: name}
	if exchange == nil || exchange.Response == nil {
		return result
	}
	var configured *config.OAuthTokenExchangeResult
	switch name {
	case "access_token":
		configured = exchange.Response.AccessToken
	case "token_type":
		configured = exchange.Response.TokenType
	case "expires_in":
		configured = exchange.Response.ExpiresIn
	case "refresh_token":
		configured = exchange.Response.RefreshToken
	case "refresh_token_expires_in":
		configured = exchange.Response.RefreshTokenExpiresIn
	case "scope":
		configured = exchange.Response.Scope
	}
	if configured != nil {
		return *configured
	}
	return result
}

func exchangeResponseValue(headers http.Header, body any, mapping config.OAuthTokenExchangeResult) any {
	if strings.EqualFold(strings.TrimSpace(mapping.In), "header") {
		return headers.Get(strings.TrimSpace(mapping.Path))
	}
	value := body
	for _, part := range strings.Split(strings.TrimSpace(mapping.Path), ".") {
		object, ok := value.(map[string]any)
		if !ok {
			return nil
		}
		value = object[part]
	}
	return value
}

func exchangeResponseString(headers http.Header, body any, mapping config.OAuthTokenExchangeResult) string {
	value := exchangeResponseValue(headers, body, mapping)
	switch typed := value.(type) {
	case string:
		return typed
	case json.Number:
		return typed.String()
	default:
		return ""
	}
}

func exchangeResponseInt64(headers http.Header, body any, mapping config.OAuthTokenExchangeResult) (int64, error) {
	value := exchangeResponseValue(headers, body, mapping)
	if value == nil || value == "" {
		return 0, nil
	}
	var raw string
	switch typed := value.(type) {
	case string:
		raw = typed
	case json.Number:
		raw = typed.String()
	default:
		return 0, fmt.Errorf("business token response expires_in must be an integer")
	}
	parsed, err := strconv.ParseInt(strings.TrimSpace(raw), 10, 64)
	if err != nil || parsed < 0 {
		return 0, fmt.Errorf("business token response expires_in must be an integer")
	}
	return parsed, nil
}

func randomValue(size int) (string, error) {
	value := make([]byte, size)
	if _, err := rand.Read(value); err != nil {
		return "", fmt.Errorf("generate OAuth state: %w", err)
	}
	return base64.RawURLEncoding.EncodeToString(value), nil
}

func openBrowser(target string) error {
	var command *exec.Cmd
	switch runtime.GOOS {
	case "darwin":
		command = exec.Command("open", target)
	case "windows":
		command = exec.Command("rundll32", "url.dll,FileProtocolHandler", target)
	default:
		command = exec.Command("xdg-open", target)
	}
	return command.Start()
}
