package {{ groupPackageName .Group }}

import (
	"fmt"

	"{{ .Module }}/internal/cli"

	"github.com/spf13/cobra"
)

func NewCommand() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "{{ .Group.Name }}",
		Short: "{{ .Group.Name }} operations",
	}
{{- range .Group.Operations }}
	cmd.AddCommand(new{{ .CommandName | pascal }}Command())
{{- end }}
	return cmd
}

{{- range .Group.Operations }}
{{- $operation := . }}
func new{{ .CommandName | pascal }}Command() *cobra.Command {
{{- if and .BodyMode (ne .BodyMode "form-urlencoded") }}
	var bodyData string
{{- end }}
{{- if .FileFields }}
	var uploadFile string
{{- end }}
{{- if operationHasHeaderParams . }}
	var headers []string
{{- end }}
{{- range .Parameters }}
{{- if or (eq .In "path") (eq .In "query") }}
	var param{{ goParamFieldName . }} {{ goType .Type }}
{{- end }}
{{- end }}
{{- range .BodyFields }}
{{- if goBodyFieldHasFlag . }}
	var body{{ goBodyFieldName . }} {{ goType .Type }}
{{- end }}
{{- end }}
	cmd := &cobra.Command{
		Use:   "{{ .CommandName }}",
		Short: "{{ .Method }} {{ .Path }}",
{{- if eq .BodyMode "simple-json" }}
		Long:  "{{ .Method }} {{ .Path }}\n\nBody input: {{ if bodyFlagHelp .BodyFields }}{{ bodyFlagHelp .BodyFields }}, or {{ end }}--data (inline JSON, @file, or - for stdin){{ if .FileFields }}; file upload: --file [field=]path{{ end }}",
{{- else if eq .BodyMode "file-or-data" }}
		Long:  "{{ .Method }} {{ .Path }}\n\nBody input: --data (inline JSON, @file, or - for stdin){{ if .FileFields }}; file upload: --file [field=]path{{ end }}",
{{- else if eq .BodyMode "form-urlencoded" }}
		Long:  "{{ .Method }} {{ .Path }}\n\nBody input: application/x-www-form-urlencoded fields exposed as flags",
{{- end }}
		RunE: func(cmd *cobra.Command, args []string) error {
{{- if and .BodyMode .FileFields }}
			if bodyData == "-" && uploadFile == "-" {
				return fmt.Errorf("--data and --file cannot both read from stdin")
			}
{{- end }}
{{- if and .BodyMode (ne .BodyMode "form-urlencoded") }}
			resolvedBodyData, err := cli.ResolveInput(bodyData, cmd.InOrStdin())
			if err != nil {
				return fmt.Errorf("--data: %w", err)
			}
{{- end }}
			input := {{ .CommandName | pascal }}Input{
{{- range .Parameters }}
{{- if or (eq .In "path") (eq .In "query") }}
				{{ goParamFieldName . }}: param{{ goParamFieldName . }},
{{- end }}
{{- end }}
{{- if and .BodyMode (ne .BodyMode "form-urlencoded") }}
				BodyData: resolvedBodyData,
{{- end }}
{{- if .FileFields }}
				UploadFile: uploadFile,
{{- end }}
{{- if operationHasHeaderParams . }}
				Headers: headers,
{{- end }}
{{- range .BodyFields }}
{{- if goBodyFieldHasFlag . }}
				{{ goBodyFieldName . }}: body{{ goBodyFieldName . }},
{{- end }}
{{- end }}
			}
			result, err := Invoke{{ .CommandName | pascal }}(input)
			if err != nil {
				return err
			}
			if cli.JSONEnabled(cmd) {
				rendered, err := cli.JSONSuccess(cmd.CommandPath(), result.Message, result)
				if err != nil {
					return err
				}
				_, err = fmt.Fprintln(cmd.OutOrStdout(), rendered)
				return err
			}
			_, err = fmt.Fprintln(cmd.OutOrStdout(), result.Message)
			return err
		},
	}
{{- if and .BodyMode (ne .BodyMode "form-urlencoded") }}
	cmd.Flags().StringVar(&bodyData, "data", "", "JSON request body; use @file or - for stdin")
{{- end }}
{{- if .FileFields }}
	cmd.Flags().StringVar(&uploadFile, "file", "", "File upload [field=]path")
{{- end }}
{{- if operationHasHeaderParams . }}
	cmd.Flags().StringArrayVarP(&headers, "header", "H", nil, "Request header in 'Name: Value' format; repeatable")
{{- end }}
{{- range .Parameters }}
{{- if eq .In "path" }}
{{- if eq (goType .Type) "string" }}
	cmd.Flags().StringVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", "", "Path parameter: {{ .Name }}")
{{- else if eq (goType .Type) "int" }}
	cmd.Flags().IntVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", 0, "Path parameter: {{ .Name }}")
{{- else if eq (goType .Type) "float64" }}
	cmd.Flags().Float64Var(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", 0, "Path parameter: {{ .Name }}")
{{- else if eq (goType .Type) "bool" }}
	cmd.Flags().BoolVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", false, "Path parameter: {{ .Name }}")
{{- end }}
{{- if .Required }}
	_ = cmd.MarkFlagRequired("{{ goParamFlagName . }}")
{{- end }}
{{- end }}
{{- if eq .In "query" }}
{{- if eq (goType .Type) "string" }}
	cmd.Flags().StringVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", "", "Query parameter: {{ .Name }}")
{{- else if eq (goType .Type) "int" }}
	cmd.Flags().IntVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", 0, "Query parameter: {{ .Name }}")
{{- else if eq (goType .Type) "float64" }}
	cmd.Flags().Float64Var(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", 0, "Query parameter: {{ .Name }}")
{{- else if eq (goType .Type) "bool" }}
	cmd.Flags().BoolVar(&param{{ goParamFieldName . }}, "{{ goParamFlagName . }}", false, "Query parameter: {{ .Name }}")
{{- end }}
{{- if .Required }}
	_ = cmd.MarkFlagRequired("{{ goParamFlagName . }}")
{{- end }}
{{- end }}
{{- end }}
{{- range .BodyFields }}
{{- if goBodyFieldHasFlag . }}
{{- if eq (goType .Type) "string" }}
	cmd.Flags().StringVar(&body{{ goBodyFieldName . }}, "{{ goBodyFlagName . }}", "", "{{ if eq $operation.BodyMode "form-urlencoded" }}Form{{ else }}JSON body{{ end }} field: {{ .Name }}")
{{- else if eq (goType .Type) "int" }}
	cmd.Flags().IntVar(&body{{ goBodyFieldName . }}, "{{ goBodyFlagName . }}", 0, "{{ if eq $operation.BodyMode "form-urlencoded" }}Form{{ else }}JSON body{{ end }} field: {{ .Name }}")
{{- else if eq (goType .Type) "float64" }}
	cmd.Flags().Float64Var(&body{{ goBodyFieldName . }}, "{{ goBodyFlagName . }}", 0, "{{ if eq $operation.BodyMode "form-urlencoded" }}Form{{ else }}JSON body{{ end }} field: {{ .Name }}")
{{- else if eq (goType .Type) "bool" }}
	cmd.Flags().BoolVar(&body{{ goBodyFieldName . }}, "{{ goBodyFlagName . }}", false, "{{ if eq $operation.BodyMode "form-urlencoded" }}Form{{ else }}JSON body{{ end }} field: {{ .Name }}")
{{- end }}
{{- if and (eq $operation.BodyMode "form-urlencoded") .Required }}
	_ = cmd.MarkFlagRequired("{{ goBodyFlagName . }}")
{{- end }}
{{- end }}
{{- end }}
	return cmd
}
{{ end -}}
