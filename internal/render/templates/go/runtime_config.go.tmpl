func ResolveBaseURL(appName, fallback string) (string, error) {
	if value := strings.TrimSpace(os.Getenv("OPENCLI_BASE_URL")); value != "" {
		return value, nil
	}
	config, _, err := loadRuntimeFile(appName)
	if err != nil {
		return "", err
	}
	if config != nil {
		if value := strings.TrimSpace(config.BaseURL); value != "" {
			return value, nil
		}
	}
	if value := strings.TrimSpace(fallback); value != "" {
		return value, nil
	}
	return "", fmt.Errorf("missing OPENCLI_BASE_URL and runtime base_url")
}

func ResolveCredential(appName, authMode, defaultHeader string) (string, string, error) {
	envName := "OPENCLI_AUTH_TOKEN"
	if authMode == "api_key" {
		envName = "OPENCLI_API_KEY"
	}
	envValue := strings.TrimSpace(os.Getenv(envName))
	if envValue != "" && authMode != "api_key" {
		return defaultHeader, envValue, nil
	}
	config, path, err := loadRuntimeFile(appName)
	if err != nil {
		return "", "", err
	}
	if config == nil || config.Auth == nil {
		if envValue != "" {
			return defaultHeader, envValue, nil
		}
		return unresolvedCredential(authMode, defaultHeader)
	}
	expectedType := authMode
	if authMode == "token" || authMode == "" {
		expectedType = "bearer"
	}
	if strings.TrimSpace(config.Auth.Type) != expectedType {
		return "", "", fmt.Errorf("runtime auth type %q is incompatible with generated auth mode %q", config.Auth.Type, authMode)
	}
	header := strings.TrimSpace(config.Auth.Header)
	aadHeader := header
	if expectedType == "bearer" {
		header = "Authorization"
	} else if header == "" {
		header = defaultHeader
		aadHeader = header
	}
	if envValue != "" {
		return header, envValue, nil
	}
	if strings.TrimSpace(config.Auth.EncryptedValue) == "" {
		return unresolvedCredential(authMode, header)
	}
	secret, err := decryptRuntimeValue(config.Auth.EncryptedValue, expectedType, aadHeader)
	if err != nil {
		return "", "", fmt.Errorf("decrypt runtime credential from %s: %w", path, err)
	}
	return header, secret, nil
}

func ResolveOAuthToken(appName string) (string, error) {
	oauthTokenCache.Lock()
	if oauthTokenCache.value != "" && time.Until(oauthTokenCache.expiresAt) > 5*time.Minute {
		token := oauthTokenCache.value
		oauthTokenCache.Unlock()
		return token, nil
	}
	oauthTokenCache.Unlock()
	config, path, err := loadRuntimeFile(appName)
	if err != nil {
		return "", err
	}
	if config == nil || config.Auth == nil {
		return "", fmt.Errorf("missing OAuth runtime config")
	}
	auth := config.Auth
	if strings.TrimSpace(auth.Type) != "oauth2" {
		return "", fmt.Errorf("runtime auth must be oauth2")
	}
	if strings.TrimSpace(auth.GrantType) == "authorization_code" {
		stored, err := loadOAuthAuthorizationToken(appName)
		if err != nil {
			return "", err
		}
		switch oauthAuthorizationTokenStatus(stored, time.Now()) {
		case "valid":
			oauthTokenCache.Lock()
			oauthTokenCache.value = stored.AccessToken
			oauthTokenCache.expiresAt = stored.ExpiresAt
			oauthTokenCache.Unlock()
			return stored.AccessToken, nil
		case "needs_refresh":
			response, err := requestOAuthRefreshToken(appName, *auth, stored.RefreshToken)
			if err != nil {
				return "", err
			}
			if err := SaveOAuthAuthorizationToken(appName, response); err != nil {
				return "", fmt.Errorf("refresh_failed: %w", err)
			}
			return strings.TrimSpace(response.AccessToken), nil
		default:
			return "", fmt.Errorf("login_required: run %s login", appName)
		}
	}
	if strings.TrimSpace(auth.GrantType) != "client_credentials" {
		return "", fmt.Errorf("unsupported OAuth grant_type %q", auth.GrantType)
	}
	if strings.TrimSpace(auth.ClientID) == "" || strings.TrimSpace(auth.TokenURL) == "" {
		return "", fmt.Errorf("OAuth runtime config requires client_id and token_url")
	}

	secret := strings.TrimSpace(os.Getenv("OPENCLI_OAUTH_CLIENT_SECRET"))
	if secret == "" {
		if strings.TrimSpace(auth.EncryptedValue) == "" {
			return "", fmt.Errorf("missing OAuth client secret: set OPENCLI_OAUTH_CLIENT_SECRET or configure runtime auth")
		}
		secret, err = decryptRuntimeValue(auth.EncryptedValue, "oauth2", oauth2AADContext(*auth))
		if err != nil {
			return "", fmt.Errorf("decrypt OAuth client secret from %s: %w", path, err)
		}
	}
	token, expiresIn, err := requestClientCredentialsToken(*auth, secret)
	if err != nil {
		return "", err
	}
	oauthTokenCache.Lock()
	oauthTokenCache.value = token
	if expiresIn > 0 {
		oauthTokenCache.expiresAt = time.Now().Add(time.Duration(expiresIn) * time.Second)
	} else {
		oauthTokenCache.expiresAt = time.Now().Add(5 * time.Minute)
	}
	oauthTokenCache.Unlock()
	return token, nil
}

type OAuthAuthorizationConfig struct {
	AuthorizationURL string
	TokenURL         string
	ClientID         string
	RedirectURI      string
	Scopes           []string
	PKCEEnabled      bool
	PKCEMethod       string
	OIDCEnabled      bool
	OIDCIssuer       string
	TokenExchange    *OAuthTokenExchangeConfig
}

func LoadOAuthAuthorizationConfig(appName string) (OAuthAuthorizationConfig, error) {
	config, _, err := loadRuntimeFile(appName)
	if err != nil {
		return OAuthAuthorizationConfig{}, err
	}
	if config == nil || config.Auth == nil {
		return OAuthAuthorizationConfig{}, fmt.Errorf("missing OAuth runtime config")
	}
	auth := config.Auth
	if strings.TrimSpace(auth.Type) != "oauth2" || strings.TrimSpace(auth.GrantType) != "authorization_code" {
		return OAuthAuthorizationConfig{}, fmt.Errorf("runtime auth must be oauth2 authorization_code")
	}
	if strings.TrimSpace(auth.AuthorizationURL) == "" || strings.TrimSpace(auth.TokenURL) == "" || strings.TrimSpace(auth.ClientID) == "" {
		return OAuthAuthorizationConfig{}, fmt.Errorf("OAuth authorization_code requires authorization_url, token_url, and client_id")
	}
	if redirectURI := strings.TrimSpace(auth.RedirectURI); redirectURI != "" {
		if err := validateOAuthLoopbackRedirectURI(redirectURI); err != nil {
			return OAuthAuthorizationConfig{}, err
		}
	}
	pkceEnabled := auth.PKCE != nil && auth.PKCE.Enabled
	pkceMethod := ""
	if auth.PKCE != nil {
		pkceMethod = strings.TrimSpace(auth.PKCE.Method)
	}
	if pkceEnabled && pkceMethod != "" && !strings.EqualFold(pkceMethod, "S256") {
		return OAuthAuthorizationConfig{}, fmt.Errorf("OAuth PKCE method must be S256")
	}
	oidcEnabled := auth.OIDC != nil && auth.OIDC.Enabled
	oidcIssuer := ""
	if auth.OIDC != nil {
		oidcIssuer = strings.TrimSpace(auth.OIDC.Issuer)
	}
	if oidcEnabled {
		if err := validateOAuthOIDCIssuer(oidcIssuer, auth.Scopes); err != nil {
			return OAuthAuthorizationConfig{}, err
		}
	}
	return OAuthAuthorizationConfig{
		AuthorizationURL: strings.TrimSpace(auth.AuthorizationURL),
		TokenURL:         strings.TrimSpace(auth.TokenURL),
		ClientID:         strings.TrimSpace(auth.ClientID),
		RedirectURI:      strings.TrimSpace(auth.RedirectURI),
		Scopes:           append([]string(nil), auth.Scopes...),
		PKCEEnabled:      pkceEnabled,
		PKCEMethod:       pkceMethod,
		OIDCEnabled:      oidcEnabled,
		OIDCIssuer:       oidcIssuer,
		TokenExchange:    auth.TokenExchange,
	}, nil
}

func validateOAuthLoopbackRedirectURI(value string) error {
	parsed, err := url.Parse(value)
	if err != nil || parsed.Scheme != "http" || parsed.Hostname() != "127.0.0.1" || parsed.Port() == "" || parsed.Path == "" || parsed.Path == "/" || parsed.RawQuery != "" || parsed.Fragment != "" || parsed.User != nil {
		return fmt.Errorf("invalid OAuth redirect_uri: must be HTTP 127.0.0.1 with a port and callback path")
	}
	return nil
}

func validateOAuthOIDCIssuer(issuer string, scopes []string) error {
	parsed, err := url.Parse(issuer)
	loopbackHTTP := err == nil && parsed.Scheme == "http" && (parsed.Hostname() == "127.0.0.1" || parsed.Hostname() == "localhost")
	if err != nil || parsed.Host == "" || parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" || (parsed.Scheme != "https" && !loopbackHTTP) {
		return fmt.Errorf("invalid OAuth oidc_issuer: must use HTTPS except for loopback development")
	}
	for _, scope := range scopes {
		if strings.TrimSpace(scope) == "openid" {
			return nil
		}
	}
	return fmt.Errorf("OAuth OIDC requires the openid scope")
}

type OAuthTokenResponse struct {
	AccessToken           string
	RefreshToken          string
	TokenType             string
	Scope                 string
	ExpiresIn             int64
	RefreshTokenExpiresIn int64
	IDToken               string
}

type OAuthAuthorizationToken struct {
	AccessToken      string    `json:"access_token"`
	RefreshToken     string    `json:"refresh_token,omitempty"`
	TokenType        string    `json:"token_type"`
	Scope            string    `json:"scope,omitempty"`
	ExpiresAt        time.Time `json:"expires_at"`
	RefreshExpiresAt time.Time `json:"refresh_expires_at,omitempty"`
}

func SaveOAuthAuthorizationToken(appName string, response OAuthTokenResponse) error {
	response.AccessToken = strings.TrimSpace(response.AccessToken)
	response.RefreshToken = strings.TrimSpace(response.RefreshToken)
	response.TokenType = strings.TrimSpace(response.TokenType)
	if response.AccessToken == "" {
		return fmt.Errorf("OAuth token response is missing access_token")
	}
	if response.TokenType == "" {
		response.TokenType = "Bearer"
	}
	if !strings.EqualFold(response.TokenType, "Bearer") {
		return fmt.Errorf("unsupported OAuth token_type %q", response.TokenType)
	}
	expiresAt := time.Now().Add(5 * time.Minute)
	if response.ExpiresIn > 0 {
		expiresAt = time.Now().Add(time.Duration(response.ExpiresIn) * time.Second)
	}
	var refreshExpiresAt time.Time
	if response.RefreshTokenExpiresIn > 0 {
		refreshExpiresAt = time.Now().Add(time.Duration(response.RefreshTokenExpiresIn) * time.Second)
	}
	token := OAuthAuthorizationToken{
		AccessToken:      response.AccessToken,
		RefreshToken:     response.RefreshToken,
		TokenType:        "Bearer",
		Scope:            strings.TrimSpace(response.Scope),
		ExpiresAt:        expiresAt,
		RefreshExpiresAt: refreshExpiresAt,
	}
	payload, err := json.Marshal(token)
	if err != nil {
		return fmt.Errorf("encode OAuth session: %w", err)
	}
	path, err := oauthAuthorizationTokenPath(appName)
	if err != nil {
		return err
	}
	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
		return fmt.Errorf("create OAuth session directory: %w", err)
	}
	temporary, err := os.CreateTemp(filepath.Dir(path), ".oauth-token-*")
	if err != nil {
		return fmt.Errorf("create temporary OAuth session: %w", err)
	}
	temporaryPath := temporary.Name()
	defer os.Remove(temporaryPath)
	if err := temporary.Chmod(0o600); err != nil {
		_ = temporary.Close()
		return fmt.Errorf("protect temporary OAuth session: %w", err)
	}
	if _, err := temporary.Write(payload); err != nil {
		_ = temporary.Close()
		return fmt.Errorf("write temporary OAuth session: %w", err)
	}
	if err := temporary.Close(); err != nil {
		return fmt.Errorf("close temporary OAuth session: %w", err)
	}
	if err := os.Rename(temporaryPath, path); err != nil {
		return fmt.Errorf("replace OAuth session: %w", err)
	}
	oauthTokenCache.Lock()
	oauthTokenCache.value = response.AccessToken
	oauthTokenCache.expiresAt = expiresAt
	oauthTokenCache.Unlock()
	return nil
}

func ClearOAuthAuthorizationToken(appName string) error {
	path, err := oauthAuthorizationTokenPath(appName)
	if err != nil {
		return err
	}
	err = os.Remove(path)
	if err != nil && !os.IsNotExist(err) {
		return fmt.Errorf("remove OAuth session: %w", err)
	}
	oauthTokenCache.Lock()
	oauthTokenCache.value = ""
	oauthTokenCache.expiresAt = time.Time{}
	oauthTokenCache.Unlock()
	return nil
}

func OAuthAuthorizationStatus(appName string) (string, error) {
	token, err := readOAuthAuthorizationToken(appName)
	if err != nil {
		if os.IsNotExist(err) {
			return "not_logged_in", nil
		}
		return "", err
	}
	return oauthAuthorizationTokenStatus(token, time.Now()), nil
}

func oauthAuthorizationTokenStatus(token OAuthAuthorizationToken, now time.Time) string {
	if strings.TrimSpace(token.AccessToken) != "" && token.ExpiresAt.After(now.Add(5*time.Minute)) {
		return "valid"
	}
	if strings.TrimSpace(token.RefreshToken) != "" && token.RefreshExpiresAt.After(now) {
		return "needs_refresh"
	}
	return "expired"
}

func loadOAuthAuthorizationToken(appName string) (OAuthAuthorizationToken, error) {
	token, err := readOAuthAuthorizationToken(appName)
	if err != nil {
		if os.IsNotExist(err) {
			return OAuthAuthorizationToken{}, fmt.Errorf("login_required: run %s login", appName)
		}
		return OAuthAuthorizationToken{}, err
	}
	return token, nil
}

func readOAuthAuthorizationToken(appName string) (OAuthAuthorizationToken, error) {
	path, err := oauthAuthorizationTokenPath(appName)
	if err != nil {
		return OAuthAuthorizationToken{}, err
	}
	raw, err := os.ReadFile(path)
	if err != nil {
		return OAuthAuthorizationToken{}, err
	}
	var token OAuthAuthorizationToken
	if err := json.Unmarshal(raw, &token); err != nil {
		return OAuthAuthorizationToken{}, fmt.Errorf("decode OAuth session: %w", err)
	}
	token.AccessToken = strings.TrimSpace(token.AccessToken)
	token.RefreshToken = strings.TrimSpace(token.RefreshToken)
	return token, nil
}

type oauthTokenEndpointResponse struct {
	Code                  int    `json:"code"`
	Msg                   string `json:"msg"`
	Error                 string `json:"error"`
	ErrorDescription      string `json:"error_description"`
	AccessToken           string `json:"access_token"`
	RefreshToken          string `json:"refresh_token"`
	TokenType             string `json:"token_type"`
	Scope                 string `json:"scope"`
	ExpiresIn             int64  `json:"expires_in"`
	RefreshTokenExpiresIn int64  `json:"refresh_token_expires_in"`
}

func requestOAuthRefreshToken(appName string, auth runtimeAuth, refreshToken string) (OAuthTokenResponse, error) {
	endpoint, err := url.Parse(strings.TrimSpace(auth.TokenURL))
	if err != nil || endpoint.Scheme == "" || endpoint.Host == "" {
		return OAuthTokenResponse{}, fmt.Errorf("invalid OAuth token_url")
	}
	values := url.Values{
		"grant_type":    {"refresh_token"},
		"client_id":     {strings.TrimSpace(auth.ClientID)},
		"refresh_token": {strings.TrimSpace(refreshToken)},
	}
	req, err := http.NewRequest(http.MethodPost, endpoint.String(), strings.NewReader(values.Encode()))
	if err != nil {
		return OAuthTokenResponse{}, fmt.Errorf("build OAuth refresh request: %w", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.Header.Set("Accept", "application/json")
	resp, err := (&http.Client{Timeout: 30 * time.Second}).Do(req)
	if err != nil {
		return OAuthTokenResponse{}, fmt.Errorf("refresh_failed: request OAuth token endpoint: %w", err)
	}
	defer resp.Body.Close()
	var body oauthTokenEndpointResponse
	if err := json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&body); err != nil {
		return OAuthTokenResponse{}, fmt.Errorf("refresh_failed: decode OAuth refresh response: %w", err)
	}
	if strings.EqualFold(strings.TrimSpace(body.Error), "invalid_grant") {
		return OAuthTokenResponse{}, fmt.Errorf("login_required: run %s login", appName)
	}
	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices || body.Code != 0 || body.Error != "" {
		description := strings.TrimSpace(body.ErrorDescription)
		if description == "" {
			description = strings.TrimSpace(body.Msg)
		}
		if description == "" {
			description = resp.Status
		}
		return OAuthTokenResponse{}, fmt.Errorf("refresh_failed: token endpoint rejected refresh: %s", description)
	}
	if strings.TrimSpace(body.AccessToken) == "" || strings.TrimSpace(body.RefreshToken) == "" {
		return OAuthTokenResponse{}, fmt.Errorf("refresh_failed: token endpoint response is missing rotated tokens")
	}
	tokenType := strings.TrimSpace(body.TokenType)
	if tokenType == "" {
		httpx.Tracef("[opencli][oauth] token_type missing; defaulting to Bearer")
		tokenType = "Bearer"
	}
	return OAuthTokenResponse{
		AccessToken:           body.AccessToken,
		RefreshToken:          body.RefreshToken,
		TokenType:             tokenType,
		Scope:                 body.Scope,
		ExpiresIn:             body.ExpiresIn,
		RefreshTokenExpiresIn: body.RefreshTokenExpiresIn,
	}, nil
}

func oauthAuthorizationTokenPath(appName string) (string, error) {
	if explicit := strings.TrimSpace(os.Getenv("OPENCLI_OAUTH_TOKEN_FILE")); explicit != "" {
		return explicit, nil
	}
	auth, err := LoadOAuthAuthorizationConfig(appName)
	if err != nil {
		return "", err
	}
	identity := strings.Join([]string{auth.ClientID, auth.AuthorizationURL, auth.TokenURL}, "\n")
	namespace := fmt.Sprintf("%x", sha256.Sum256([]byte(identity)))
	home, err := os.UserHomeDir()
	if err != nil {
		return "", fmt.Errorf("resolve OAuth session directory: %w", err)
	}
	return filepath.Join(home, ".opencli", "oauth2", namespace, "oauth-token.json"), nil
}

func requestClientCredentialsToken(auth runtimeAuth, secret string) (string, int64, error) {
	endpoint, err := url.Parse(strings.TrimSpace(auth.TokenURL))
	if err != nil || endpoint.Scheme == "" || endpoint.Host == "" {
		return "", 0, fmt.Errorf("invalid OAuth token_url")
	}
	values := url.Values{"grant_type": {strings.TrimSpace(auth.GrantType)}}
	if len(auth.Scopes) > 0 {
		values.Set("scope", strings.Join(auth.Scopes, " "))
	}

	var body io.Reader
	placement := strings.TrimSpace(auth.ClientAuth.Placement)
	switch placement {
	case "query":
		values.Set("client_id", strings.TrimSpace(auth.ClientID))
		values.Set("client_secret", secret)
		endpoint.RawQuery = values.Encode()
	case "body":
		values.Set("client_id", strings.TrimSpace(auth.ClientID))
		values.Set("client_secret", secret)
		body = strings.NewReader(values.Encode())
	case "basic":
		body = strings.NewReader(values.Encode())
	default:
		return "", 0, fmt.Errorf("unsupported OAuth client secret placement %q", placement)
	}

	req, err := http.NewRequest(http.MethodPost, endpoint.String(), body)
	if err != nil {
		return "", 0, fmt.Errorf("build OAuth token request")
	}
	if placement != "query" {
		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	}
	if placement == "basic" {
		req.SetBasicAuth(strings.TrimSpace(auth.ClientID), secret)
	}
	resp, err := (&http.Client{Timeout: 30 * time.Second}).Do(req)
	if err != nil {
		return "", 0, fmt.Errorf("request OAuth token endpoint %s://%s%s: request failed", endpoint.Scheme, endpoint.Host, endpoint.Path)
	}
	defer resp.Body.Close()
	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
		return "", 0, fmt.Errorf("OAuth token endpoint returned %s", resp.Status)
	}
	var result struct {
		AccessToken string `json:"access_token"`
		TokenType   string `json:"token_type"`
		ExpiresIn   int64  `json:"expires_in"`
	}
	if err := json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&result); err != nil {
		return "", 0, fmt.Errorf("decode OAuth token response: %w", err)
	}
	if strings.TrimSpace(result.AccessToken) == "" {
		return "", 0, fmt.Errorf("OAuth token response is missing access_token")
	}
	if result.TokenType != "" && !strings.EqualFold(strings.TrimSpace(result.TokenType), "bearer") {
		return "", 0, fmt.Errorf("unsupported OAuth token_type %q", result.TokenType)
	}
	return strings.TrimSpace(result.AccessToken), result.ExpiresIn, nil
}

func oauth2AADContext(auth runtimeAuth) string {
	return strings.Join([]string{
		strings.TrimSpace(auth.GrantType),
		strings.TrimSpace(auth.Scheme),
		strings.TrimSpace(auth.TokenURL),
		strings.TrimSpace(auth.ClientID),
		strings.TrimSpace(auth.ClientAuth.Method),
		strings.TrimSpace(auth.ClientAuth.Placement),
	}, "|")
}

func unresolvedCredential(authMode, header string) (string, string, error) {
	if !runtimeCredentialRequired {
		return header, "", nil
	}
	return "", "", missingCredentialError(authMode)
}

func missingCredentialError(authMode string) error {
	if authMode == "api_key" {
		return fmt.Errorf("missing API key: set OPENCLI_API_KEY or configure runtime auth")
	}
	return fmt.Errorf("missing bearer token: set OPENCLI_AUTH_TOKEN or configure runtime auth")
}

func loadRuntimeFile(appName string) (*runtimeFile, string, error) {
	if explicit := strings.TrimSpace(os.Getenv("OPENCLI_CONFIG")); explicit != "" {
		config, err := readRuntimeFile(explicit)
		if err != nil {
			return nil, explicit, err
		}
		return config, explicit, nil
	}

	var candidates []string
	if executable, err := os.Executable(); err == nil {
		if resolved, resolveErr := filepath.EvalSymlinks(executable); resolveErr == nil {
			executable = resolved
		}
		if binDir := filepath.Dir(executable); binDir != "" {
			if bundleRoot := filepath.Dir(binDir); bundleRoot != "" {
				candidates = append(candidates, filepath.Clean(filepath.Join(bundleRoot, "config", "runtime.yaml")))
			}
		}
	}
	if root := strings.TrimSpace(os.Getenv("XDG_CONFIG_HOME")); root != "" {
		candidates = append(candidates, filepath.Join(root, appName, "config.yaml"))
	} else if home, err := os.UserHomeDir(); err == nil {
		candidates = append(candidates, filepath.Join(home, ".config", appName, "config.yaml"))
	}
	for _, path := range candidates {
		config, err := readRuntimeFile(path)
		if err == nil {
			return config, path, nil
		}
		if !os.IsNotExist(err) {
			return nil, path, err
		}
	}
	return nil, "", nil
}

func readRuntimeFile(path string) (*runtimeFile, error) {
	raw, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var config runtimeFile
	decoder := yaml.NewDecoder(bytes.NewReader(raw))
	decoder.KnownFields(true)
	if err := decoder.Decode(&config); err != nil {
		return nil, fmt.Errorf("parse runtime config %s: %w", path, err)
	}
	if version := strings.TrimSpace(config.Version); version != "" && version != "v1" {
		return nil, fmt.Errorf("parse runtime config %s: version must be v1", path)
	}
	return &config, nil
}

func decryptRuntimeValue(envelope, authType, header string) (string, error) {
	if !hasSealedRuntimeKey {
		return "", fmt.Errorf("generated CLI has no sealing key")
	}
	const prefix = {{ printf "%q" (runtimeEnvelopePrefix) }}
	const suffix = {{ printf "%q" (runtimeEnvelopeSuffix) }}
	if !strings.HasPrefix(envelope, prefix) || !strings.HasSuffix(envelope, suffix) {
		return "", fmt.Errorf("invalid ENC[v1] envelope")
	}
	payload, err := base64.RawURLEncoding.DecodeString(strings.TrimSuffix(strings.TrimPrefix(envelope, prefix), suffix))
	if err != nil {
		return "", fmt.Errorf("decode sealed credential: %w", err)
	}
	var key [32]byte
	for i := range key {
		key[i] = sealedRuntimeKeyShareA[i] ^ sealedRuntimeKeyShareB[i]
	}
	block, err := aes.NewCipher(key[:])
	if err != nil {
		return "", fmt.Errorf("create credential cipher: %w", err)
	}
	gcm, err := cipher.NewGCM(block)
	if err != nil {
		return "", fmt.Errorf("create credential cipher mode: %w", err)
	}
	if len(payload) <= gcm.NonceSize() {
		return "", fmt.Errorf("sealed credential payload is too short")
	}
	aad := []byte({{ printf "%q" (runtimeAADPrefix) }} + authType + ":" + strings.ToLower(strings.TrimSpace(header)))
	plaintext, err := gcm.Open(nil, payload[:gcm.NonceSize()], payload[gcm.NonceSize():], aad)
	if err != nil {
		return "", fmt.Errorf("authenticate sealed credential: %w", err)
	}
	return string(plaintext), nil
}
