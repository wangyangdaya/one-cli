package {{ groupPackageName .Group }}

import (
	"bytes"
	"encoding/json"
	"fmt"
	"io"
{{- if groupHasFileFields .Group }}
	"mime/multipart"
{{- end }}
	"net/http"
	"net/url"
{{- if groupHasFileFields .Group }}
	"os"
	"path/filepath"
{{- end }}
	"strings"
{{- if appUsesAKSK .App }}

	"{{ .Module }}/internal/auth"
	"{{ .Module }}/internal/cli"
	"{{ .Module }}/internal/config"
	"{{ .Module }}/internal/httpx"
)
{{- else }}

	"{{ .Module }}/internal/cli"
	"{{ .Module }}/internal/config"
	"{{ .Module }}/internal/httpx"
)
{{- end }}
{{ range .Group.Operations }}
type {{ .CommandName | pascal }}Input struct {
{{- range .Parameters }}
{{- if or (eq .In "path") (eq .In "query") }}
	{{ goInputFieldName . }} {{ goType .Type }}
{{- end }}
{{- end }}
{{- if operationHasHeaderParams . }}
	Headers []string
{{- end }}
{{- if .BodyMode }}
	BodyData string
{{- end }}
{{- if .FileFields }}
	UploadFile string
{{- end }}
{{- range .BodyFields }}
	{{ goInputFieldName . }} {{ goType .Type }}
{{- end }}
}

func Invoke{{ .CommandName | pascal }}(input {{ .CommandName | pascal }}Input) (Result, error) {
	requestURL, err := build{{ .CommandName | pascal }}URL(input)
	if err != nil {
		return Result{}, err
	}

	body, contentType, err := build{{ .CommandName | pascal }}RequestBody(input)
	if err != nil {
		return Result{}, err
	}

	var reader io.Reader
	if len(body) > 0 {
		reader = bytes.NewReader(body)
	}

	req, err := http.NewRequest(http.Method{{ .Method | pascal }}, requestURL, reader)
	if err != nil {
		return Result{}, fmt.Errorf("build request: %w", err)
	}
	if contentType != "" {
		req.Header.Set("Content-Type", contentType)
	}
	if err := applyHeaders(req, cli.RequestHeaders()); err != nil {
		return Result{}, err
	}
{{- if operationHasHeaderParams . }}
	if err := applyHeaders(req, input.Headers); err != nil {
		return Result{}, err
	}
{{- end }}
{{- if appUsesAKSK $.App }}
	if err := auth.ApplyAKSK(req, "{{ .Method }}", "{{ .Path }}", body); err != nil {
		return Result{}, err
	}
{{- else if appUsesToken $.App }}
	applyAuthToken(req)
{{- end }}

	resp, err := httpx.NewClient().Do(req)
	if err != nil {
		return Result{}, fmt.Errorf("request {{ .Method }} {{ .Path }}: %w", err)
	}
	defer resp.Body.Close()

	payload, err := io.ReadAll(resp.Body)
	if err != nil {
		return Result{}, fmt.Errorf("read response: %w", err)
	}
	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
		return Result{}, fmt.Errorf("request failed: %s", resp.Status)
	}
	if len(bytes.TrimSpace(payload)) == 0 {
		return Result{Message: "{{ .Method }} {{ .Path }}"}, nil
	}

	var result Result
	if err := json.Unmarshal(payload, &result); err == nil && strings.TrimSpace(result.Message) != "" {
		var raw map[string]any
		if rawErr := json.Unmarshal(payload, &raw); rawErr == nil {
			result.Raw = raw
		}
		return result, nil
	}
	return Result{Message: strings.TrimSpace(string(payload))}, nil
}

func build{{ .CommandName | pascal }}RequestBody(input {{ .CommandName | pascal }}Input) ([]byte, string, error) {
{{- if .FileFields }}
	hasUpload := strings.TrimSpace(input.UploadFile) != ""
	body, err := build{{ .CommandName | pascal }}Body(input, hasUpload)
{{- else }}
	body, err := build{{ .CommandName | pascal }}Body(input)
{{- end }}
	if err != nil {
		return nil, "", err
	}
{{- if .FileFields }}
	if hasUpload {
		body, contentType, err := buildMultipartBody(input.UploadFile, {{ printf "%q" (defaultFileField .) }}, string(body))
		return body, contentType, err
	}
{{- end }}
	if len(body) == 0 {
		return nil, "", nil
	}
	return body, "application/json", nil
}

func build{{ .CommandName | pascal }}URL(input {{ .CommandName | pascal }}Input) (string, error) {
	baseURL := strings.TrimSpace(config.Lookup("OPENCLI_BASE_URL"))
	if baseURL == "" {
		return "", fmt.Errorf("missing OPENCLI_BASE_URL")
	}

	requestURL, err := url.Parse(strings.TrimRight(baseURL, "/") + "{{ .Path }}")
	if err != nil {
		return "", fmt.Errorf("parse request URL: %w", err)
	}
{{- range .Parameters }}
{{- if eq .In "path" }}
	requestURL.Path = strings.ReplaceAll(requestURL.Path, {{ printf "%q" (printf "{%s}" .Name) }}, url.PathEscape(fmt.Sprint(input.{{ goInputFieldName . }})))
{{- end }}
{{- end }}
	query := requestURL.Query()
{{- range .Parameters }}
{{- if eq .In "query" }}
{{- if eq (goType .Type) "string" }}
	if strings.TrimSpace(input.{{ goInputFieldName . }}) != "" {
		query.Set("{{ .Name }}", input.{{ goInputFieldName . }})
	}
{{- else if eq (goType .Type) "int" }}
	if input.{{ goInputFieldName . }} != 0 {
		query.Set("{{ .Name }}", fmt.Sprint(input.{{ goInputFieldName . }}))
	}
{{- else if eq (goType .Type) "float64" }}
	if input.{{ goInputFieldName . }} != 0 {
		query.Set("{{ .Name }}", fmt.Sprint(input.{{ goInputFieldName . }}))
	}
{{- else if eq (goType .Type) "bool" }}
	if input.{{ goInputFieldName . }} {
		query.Set("{{ .Name }}", fmt.Sprint(input.{{ goInputFieldName . }}))
	}
{{- end }}
{{- end }}
{{- end }}
	requestURL.RawQuery = query.Encode()
	return requestURL.String(), nil
}

func build{{ .CommandName | pascal }}Body(input {{ .CommandName | pascal }}Input{{ if .FileFields }}, allowEmpty bool{{ end }}) ([]byte, error) {
{{- if not .BodyMode }}
{{- if .FileFields }}
	_ = allowEmpty
{{- end }}
	return nil, nil
{{- else }}
	hasData := strings.TrimSpace(input.BodyData) != ""
	hasFlagBody := false
{{- range .BodyFields }}
{{- if eq (goType .Type) "string" }}
	hasFlagBody = hasFlagBody || strings.TrimSpace(input.{{ goInputFieldName . }}) != ""
{{- else if eq (goType .Type) "int" }}
	hasFlagBody = hasFlagBody || input.{{ goInputFieldName . }} != 0
{{- else if eq (goType .Type) "float64" }}
	hasFlagBody = hasFlagBody || input.{{ goInputFieldName . }} != 0
{{- else if eq (goType .Type) "bool" }}
	hasFlagBody = hasFlagBody || input.{{ goInputFieldName . }}
{{- end }}
{{- end }}

	switch {
	case hasFlagBody && hasData:
		return nil, fmt.Errorf("body input flags cannot be combined with --data")
	case hasData:
		if !json.Valid([]byte(input.BodyData)) {
			return nil, fmt.Errorf("--data invalid JSON format")
		}
		return []byte(input.BodyData), nil
{{- if eq .BodyMode "simple-json" }}
	case hasFlagBody:
{{- range .BodyFields }}
{{- if .Required }}
{{- if eq (goType .Type) "string" }}
		if strings.TrimSpace(input.{{ goInputFieldName . }}) == "" {
			return nil, fmt.Errorf("missing required body field: {{ .Name }}")
		}
{{- else if eq (goType .Type) "int" }}
		if input.{{ goInputFieldName . }} == 0 {
			return nil, fmt.Errorf("missing required body field: {{ .Name }}")
		}
{{- else if eq (goType .Type) "float64" }}
		if input.{{ goInputFieldName . }} == 0 {
			return nil, fmt.Errorf("missing required body field: {{ .Name }}")
		}
{{- else if eq (goType .Type) "bool" }}
		if !input.{{ goInputFieldName . }} {
			return nil, fmt.Errorf("missing required body field: {{ .Name }}")
		}
{{- end }}
{{- end }}
{{- end }}
		var parts []string
{{- range .BodyFields }}
{{- if eq (goType .Type) "string" }}
		if strings.TrimSpace(input.{{ goInputFieldName . }}) != "" {
			value, err := json.Marshal(input.{{ goInputFieldName . }})
			if err != nil {
				return nil, fmt.Errorf("encode body field {{ .Name }}: %w", err)
			}
			parts = append(parts, {{ printf "%q" (printf "\"%s\":" .Name) }}+string(value))
		}
{{- else if eq (goType .Type) "int" }}
		if input.{{ goInputFieldName . }} != 0 {
			value, err := json.Marshal(input.{{ goInputFieldName . }})
			if err != nil {
				return nil, fmt.Errorf("encode body field {{ .Name }}: %w", err)
			}
			parts = append(parts, {{ printf "%q" (printf "\"%s\":" .Name) }}+string(value))
		}
{{- else if eq (goType .Type) "float64" }}
		if input.{{ goInputFieldName . }} != 0 {
			value, err := json.Marshal(input.{{ goInputFieldName . }})
			if err != nil {
				return nil, fmt.Errorf("encode body field {{ .Name }}: %w", err)
			}
			parts = append(parts, {{ printf "%q" (printf "\"%s\":" .Name) }}+string(value))
		}
{{- else if eq (goType .Type) "bool" }}
		if input.{{ goInputFieldName . }} {
			value, err := json.Marshal(input.{{ goInputFieldName . }})
			if err != nil {
				return nil, fmt.Errorf("encode body field {{ .Name }}: %w", err)
			}
			parts = append(parts, {{ printf "%q" (printf "\"%s\":" .Name) }}+string(value))
		}
{{- end }}
{{- end }}
		return []byte("{" + strings.Join(parts, ",") + "}"), nil
{{- end }}
	default:
{{- if .BodyRequired }}
{{- if .FileFields }}
		if allowEmpty {
			return nil, nil
		}
{{- end }}
		return nil, fmt.Errorf("request body is required")
{{- else }}
		return nil, nil
{{- end }}
	}
{{- end }}
}
{{ end -}}

{{- if groupHasFileFields .Group }}
func buildMultipartBody(fileSpec, defaultField, data string) ([]byte, string, error) {
	fieldName := strings.TrimSpace(defaultField)
	filePath := strings.TrimSpace(fileSpec)
	if explicitField, explicitPath, ok := strings.Cut(fileSpec, "="); ok && strings.TrimSpace(explicitField) != "" {
		fieldName = strings.TrimSpace(explicitField)
		filePath = strings.TrimSpace(explicitPath)
	}
	if fieldName == "" {
		return nil, "", fmt.Errorf("--file requires field=path when the operation declares multiple file fields")
	}
	if filePath == "" {
		return nil, "", fmt.Errorf("--file path is empty")
	}

	var file io.Reader
	fileName := filepath.Base(filePath)
	if filePath == "-" {
		file = os.Stdin
		fileName = "stdin"
	} else {
		opened, err := os.Open(filePath)
		if err != nil {
			return nil, "", fmt.Errorf("open upload file %q: %w", filePath, err)
		}
		defer opened.Close()
		file = opened
	}

	var body bytes.Buffer
	writer := multipart.NewWriter(&body)
	part, err := writer.CreateFormFile(fieldName, fileName)
	if err != nil {
		return nil, "", fmt.Errorf("create multipart file field %q: %w", fieldName, err)
	}
	if _, err := io.Copy(part, file); err != nil {
		return nil, "", fmt.Errorf("read upload file %q: %w", filePath, err)
	}
	if strings.TrimSpace(data) != "" {
		var fields map[string]any
		if err := json.Unmarshal([]byte(data), &fields); err != nil {
			return nil, "", fmt.Errorf("--data must be a JSON object when used with --file: %w", err)
		}
		for name, value := range fields {
			encoded, err := json.Marshal(value)
			if err != nil {
				return nil, "", fmt.Errorf("encode multipart field %q: %w", name, err)
			}
			text := string(encoded)
			if value, ok := value.(string); ok {
				text = value
			}
			if err := writer.WriteField(name, text); err != nil {
				return nil, "", fmt.Errorf("write multipart field %q: %w", name, err)
			}
		}
	}
	if err := writer.Close(); err != nil {
		return nil, "", fmt.Errorf("close multipart body: %w", err)
	}
	return body.Bytes(), writer.FormDataContentType(), nil
}
{{- end }}

{{- if appUsesToken .App }}
func applyAuthToken(req *http.Request) {
	if req.Header.Get("Authorization") != "" {
		return
	}
	token := strings.TrimSpace(config.Lookup("OPENCLI_AUTH_TOKEN"))
	if token == "" {
		return
	}
	req.Header.Set("Authorization", "Bearer "+token)
}
{{- end }}

func applyHeaders(req *http.Request, headers []string) error {
	for _, raw := range headers {
		name, value, ok := strings.Cut(raw, ":")
		if !ok {
			name, value, ok = strings.Cut(raw, "=")
		}
		name = strings.TrimSpace(name)
		value = strings.TrimSpace(value)
		if !ok || name == "" || value == "" {
			return fmt.Errorf("invalid --header value %q: expected %q or %q", raw, "Name: Value", "Name=Value")
		}
		req.Header.Set(name, value)
	}
	return nil
}
