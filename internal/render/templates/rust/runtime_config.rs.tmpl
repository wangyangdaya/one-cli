pub fn resolve_base_url(app_name: &str, fallback: &str) -> AppResult<String> {
    if let Some(value) = env_value("OPENCLI_BASE_URL") {
        return Ok(value);
    }
    if let Some((config, _)) = load_runtime_file(app_name)? {
        let value = config.base_url.trim();
        if !value.is_empty() {
            return Ok(value.to_string());
        }
    }
    let fallback = fallback.trim();
    if !fallback.is_empty() {
        return Ok(fallback.to_string());
    }
    Err("missing OPENCLI_BASE_URL and runtime base_url".to_string())
}

pub fn resolve_credential(app_name: &str, auth_mode: &str, default_header: &str) -> AppResult<(String, Option<String>)> {
    let env_name = if auth_mode == "api_key" { "OPENCLI_API_KEY" } else { "OPENCLI_AUTH_TOKEN" };
    let env_secret = env_value(env_name);
    if env_secret.is_some() && auth_mode != "api_key" {
        return Ok((default_header.to_string(), env_secret));
    }

    let Some((config, path)) = load_runtime_file(app_name)? else {
        return match env_secret {
            Some(secret) => Ok((default_header.to_string(), Some(secret))),
            None => unresolved_credential(auth_mode, default_header),
        };
    };
    let Some(auth) = config.auth else {
        return match env_secret {
            Some(secret) => Ok((default_header.to_string(), Some(secret))),
            None => unresolved_credential(auth_mode, default_header),
        };
    };
    let expected_type = if auth_mode.is_empty() || auth_mode == "token" { "bearer" } else { auth_mode };
    if auth.auth_type.trim() != expected_type {
        return Err(format!("runtime auth type {:?} is incompatible with generated auth mode {:?}", auth.auth_type, auth_mode));
    }

    let mut header = auth.header.trim().to_string();
    let aad_header = if expected_type == "bearer" {
        header = "Authorization".to_string();
        String::new()
    } else {
        if header.is_empty() {
            header = default_header.to_string();
        }
        header.clone()
    };
    if env_secret.is_some() {
        return Ok((header, env_secret));
    }
    if auth.encrypted_value.trim().is_empty() {
        return unresolved_credential(auth_mode, &header);
    }
    let secret = decrypt_runtime_value(&auth.encrypted_value, expected_type, &aad_header)
        .map_err(|err| format!("decrypt runtime credential from {}: {err}", path.display()))?;
    Ok((header, Some(secret)))
}

pub async fn resolve_oauth_token(app_name: &str) -> AppResult<String> {
    let Some((config, path)) = load_runtime_file(app_name)? else {
        return Err("missing OAuth runtime config".to_string());
    };
    let Some(auth) = config.auth else {
        return Err("missing OAuth runtime config".to_string());
    };
    if auth.auth_type.trim() != "oauth2" {
        return Err("runtime auth must be oauth2".to_string());
    }
    if auth.grant_type.trim() == "authorization_code" {
        let token = load_oauth_authorization_token(app_name)?;
        return match oauth_authorization_token_status(&token, unix_seconds()) {
            "valid" => Ok(token.access_token.trim().to_string()),
            "needs_refresh" => refresh_oauth_authorization_token(app_name, &auth, &token.refresh_token).await,
            _ => Err(format!("login_required: run {app_name} login")),
        };
    }
    if auth.grant_type.trim() != "client_credentials" {
        return Err(format!("unsupported OAuth grant_type {:?}", auth.grant_type));
    }
    if auth.client_id.trim().is_empty() || auth.token_url.trim().is_empty() {
        return Err("OAuth runtime config requires client_id and token_url".to_string());
    }
    let secret = match env_value("OPENCLI_OAUTH_CLIENT_SECRET") {
        Some(secret) => secret,
        None if auth.encrypted_value.trim().is_empty() => {
            return Err("missing OAuth client secret: set OPENCLI_OAUTH_CLIENT_SECRET or configure runtime auth".to_string());
        }
        None => decrypt_runtime_value(&auth.encrypted_value, "oauth2", &oauth2_aad_context(&auth))
            .map_err(|err| format!("decrypt OAuth client secret from {}: {err}", path.display()))?,
    };

    let mut endpoint = reqwest::Url::parse(auth.token_url.trim()).map_err(|_| "invalid OAuth token_url".to_string())?;
    let mut parameters = vec![("grant_type".to_string(), auth.grant_type.trim().to_string())];
    if !auth.scopes.is_empty() {
        parameters.push(("scope".to_string(), auth.scopes.join(" ")));
    }
    let client = reqwest::Client::builder()
        .timeout(std::time::Duration::from_secs(30))
        .build()
        .map_err(|err| err.to_string())?;
    let placement = auth.client_auth.placement.trim();
    let mut request = match placement {
        "query" => {
            parameters.push(("client_id".to_string(), auth.client_id.trim().to_string()));
            parameters.push(("client_secret".to_string(), secret.clone()));
            {
                let mut pairs = endpoint.query_pairs_mut();
                for (name, value) in &parameters {
                    pairs.append_pair(name, value);
                }
            }
            client.post(endpoint.clone())
        }
        "body" => {
            parameters.push(("client_id".to_string(), auth.client_id.trim().to_string()));
            parameters.push(("client_secret".to_string(), secret.clone()));
            client.post(endpoint.clone()).form(&parameters)
        }
        "basic" => client.post(endpoint.clone()).form(&parameters).basic_auth(auth.client_id.trim(), Some(secret)),
        other => return Err(format!("unsupported OAuth client secret placement {other:?}")),
    };
    request = request.header("Accept", "application/json");
    let response = request.send().await.map_err(|_| {
        format!("request OAuth token endpoint {}://{}{}: request failed",
            endpoint.scheme(), endpoint.host_str().unwrap_or(""), endpoint.path())
    })?;
    if !response.status().is_success() {
        return Err(format!("OAuth token endpoint returned {}", response.status()));
    }
    let token: OAuthTokenResponse = response.json().await.map_err(|err| format!("decode OAuth token response: {err}"))?;
    if token.access_token.trim().is_empty() {
        return Err("OAuth token response is missing access_token".to_string());
    }
    if !token.token_type.trim().is_empty() && !token.token_type.eq_ignore_ascii_case("bearer") {
        return Err(format!("unsupported OAuth token_type {:?}", token.token_type));
    }
    Ok(token.access_token.trim().to_string())
}

pub fn load_oauth_authorization_config(app_name: &str) -> AppResult<OAuthAuthorizationConfig> {
    let Some((config, _)) = load_runtime_file(app_name)? else {
        return Err("missing OAuth runtime config".to_string());
    };
    let Some(auth) = config.auth else {
        return Err("missing OAuth runtime config".to_string());
    };
    if auth.auth_type.trim() != "oauth2" || auth.grant_type.trim() != "authorization_code" {
        return Err("runtime auth must be oauth2 authorization_code".to_string());
    }
    if auth.authorization_url.trim().is_empty() || auth.token_url.trim().is_empty() || auth.client_id.trim().is_empty() {
        return Err("OAuth authorization_code requires authorization_url, token_url, and client_id".to_string());
    }
    if !auth.redirect_uri.trim().is_empty() {
        validate_oauth_loopback_redirect_uri(auth.redirect_uri.trim())?;
    }
    let pkce_enabled = auth.pkce.as_ref().map(|value| value.enabled).unwrap_or(false);
    let pkce_method = auth.pkce.as_ref().map(|value| value.method.trim().to_string()).unwrap_or_default();
    if pkce_enabled && !pkce_method.is_empty() && !pkce_method.eq_ignore_ascii_case("S256") {
        return Err("OAuth PKCE method must be S256".to_string());
    }
    let oidc_enabled = auth.oidc.as_ref().map(|value| value.enabled).unwrap_or(false);
    let oidc_issuer = auth.oidc.as_ref().map(|value| value.issuer.trim().to_string()).unwrap_or_default();
    if oidc_enabled {
        validate_oauth_oidc_issuer(&oidc_issuer, &auth.scopes)?;
    }
    Ok(OAuthAuthorizationConfig {
        authorization_url: auth.authorization_url.trim().to_string(),
        token_url: auth.token_url.trim().to_string(),
        client_id: auth.client_id.trim().to_string(),
        redirect_uri: auth.redirect_uri.trim().to_string(),
        scopes: auth.scopes,
        pkce_enabled,
        pkce_method,
        oidc_enabled,
        oidc_issuer,
        token_exchange: auth.token_exchange,
    })
}

fn validate_oauth_loopback_redirect_uri(value: &str) -> AppResult<()> {
    let parsed = reqwest::Url::parse(value).map_err(|_| "invalid OAuth redirect_uri".to_string())?;
    if parsed.scheme() != "http"
        || parsed.host_str() != Some("127.0.0.1")
        || parsed.port().is_none()
        || matches!(parsed.path(), "" | "/")
        || parsed.query().is_some()
        || parsed.fragment().is_some()
        || !parsed.username().is_empty()
        || parsed.password().is_some()
    {
        return Err("invalid OAuth redirect_uri: must be HTTP 127.0.0.1 with a port and callback path".to_string());
    }
    Ok(())
}

fn validate_oauth_oidc_issuer(issuer: &str, scopes: &[String]) -> AppResult<()> {
    let parsed = reqwest::Url::parse(issuer).map_err(|_| "invalid OAuth oidc_issuer".to_string())?;
    let loopback_http = parsed.scheme() == "http" && matches!(parsed.host_str(), Some("127.0.0.1" | "localhost"));
    if parsed.host_str().is_none()
        || !parsed.username().is_empty()
        || parsed.password().is_some()
        || parsed.query().is_some()
        || parsed.fragment().is_some()
        || (parsed.scheme() != "https" && !loopback_http)
    {
        return Err("invalid OAuth oidc_issuer: must use HTTPS except for loopback development".to_string());
    }
    if !scopes.iter().any(|scope| scope.trim() == "openid") {
        return Err("OAuth OIDC requires the openid scope".to_string());
    }
    Ok(())
}

pub fn save_oauth_authorization_token(
    app_name: &str,
    access_token: &str,
    refresh_token: &str,
    token_type: &str,
    scope: &str,
    expires_in: u64,
    refresh_token_expires_in: u64,
) -> AppResult<()> {
    let access_token = access_token.trim();
    if access_token.is_empty() {
        return Err("OAuth token response is missing access_token".to_string());
    }
    let lifetime = if expires_in > 0 { expires_in } else { 300 };
    let token_type = if token_type.trim().is_empty() { "Bearer" } else { token_type.trim() };
    if !token_type.eq_ignore_ascii_case("bearer") {
        return Err(format!("unsupported OAuth token_type {token_type:?}"));
    }
    let token = OAuthAuthorizationToken {
        access_token: access_token.to_string(),
        refresh_token: refresh_token.trim().to_string(),
        token_type: "Bearer".to_string(),
        scope: scope.trim().to_string(),
        expires_at: unix_seconds().saturating_add(lifetime),
        refresh_expires_at: if refresh_token_expires_in > 0 {
            unix_seconds().saturating_add(refresh_token_expires_in)
        } else {
            0
        },
    };
    let path = oauth_authorization_token_path(app_name)?;
    if let Some(parent) = path.parent() {
        fs::create_dir_all(parent).map_err(|err| format!("create OAuth session directory: {err}"))?;
    }
    let payload = serde_json::to_vec(&token).map_err(|err| format!("encode OAuth session: {err}"))?;
    let temporary = path.with_extension(format!("tmp-{}", std::process::id()));
    let mut temporary_file = create_private_oauth_token_file(&temporary)?;
    if let Err(err) = temporary_file.write_all(&payload) {
        drop(temporary_file);
        let _ = fs::remove_file(&temporary);
        return Err(format!("write temporary OAuth session: {err}"));
    }
    drop(temporary_file);
    if let Err(err) = protect_oauth_token_file(&temporary) {
        let _ = fs::remove_file(&temporary);
        return Err(err);
    }
    if let Err(err) = fs::rename(&temporary, &path) {
        let _ = fs::remove_file(&temporary);
        return Err(format!("replace OAuth session: {err}"));
    }
    Ok(())
}

#[cfg(unix)]
fn create_private_oauth_token_file(path: &Path) -> AppResult<fs::File> {
    OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o600)
        .open(path)
        .map_err(|err| format!("create temporary OAuth session: {err}"))
}

#[cfg(not(unix))]
fn create_private_oauth_token_file(path: &Path) -> AppResult<fs::File> {
    OpenOptions::new()
        .write(true)
        .create_new(true)
        .open(path)
        .map_err(|err| format!("create temporary OAuth session: {err}"))
}

pub fn oauth_authorization_status(app_name: &str) -> AppResult<&'static str> {
    let path = oauth_authorization_token_path(app_name)?;
    let raw = match fs::read(&path) {
        Ok(raw) => raw,
        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok("not_logged_in"),
        Err(err) => return Err(format!("read OAuth session: {err}")),
    };
    let token: OAuthAuthorizationToken = serde_json::from_slice(&raw).map_err(|err| format!("decode OAuth session: {err}"))?;
    Ok(oauth_authorization_token_status(&token, unix_seconds()))
}

fn oauth_authorization_token_status(token: &OAuthAuthorizationToken, now: u64) -> &'static str {
    if !token.access_token.trim().is_empty() && token.expires_at > now.saturating_add(300) {
        "valid"
    } else if !token.refresh_token.trim().is_empty() && token.refresh_expires_at > now {
        "needs_refresh"
    } else {
        "expired"
    }
}

pub fn clear_oauth_authorization_token(app_name: &str) -> AppResult<()> {
    let path = oauth_authorization_token_path(app_name)?;
    match fs::remove_file(path) {
        Ok(()) => Ok(()),
        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(()),
        Err(err) => Err(format!("remove OAuth session: {err}")),
    }
}

fn load_oauth_authorization_token(app_name: &str) -> AppResult<OAuthAuthorizationToken> {
    let path = oauth_authorization_token_path(app_name)?;
    let raw = fs::read(&path).map_err(|err| {
        if err.kind() == std::io::ErrorKind::NotFound {
            format!("login_required: run {app_name} login")
        } else {
            format!("read OAuth session: {err}")
        }
    })?;
    let token: OAuthAuthorizationToken = serde_json::from_slice(&raw).map_err(|err| format!("decode OAuth session: {err}"))?;
    Ok(token)
}

async fn refresh_oauth_authorization_token(app_name: &str, auth: &RuntimeAuth, refresh_token: &str) -> AppResult<String> {
    let endpoint = reqwest::Url::parse(auth.token_url.trim()).map_err(|_| "invalid OAuth token_url".to_string())?;
    let form = [
        ("grant_type", "refresh_token"),
        ("client_id", auth.client_id.trim()),
        ("refresh_token", refresh_token.trim()),
    ];
    let response = reqwest::Client::builder()
        .timeout(std::time::Duration::from_secs(30))
        .build()
        .map_err(|err| err.to_string())?
        .post(endpoint)
        .form(&form)
        .send()
        .await
        .map_err(|err| format!("refresh OAuth session: {err}; run {app_name} login"))?;
    let status = response.status();
    let token: OAuthTokenResponse = response.json().await.map_err(|err| format!("decode OAuth refresh response: {err}"))?;
    if !status.is_success() || token.access_token.trim().is_empty() || token.refresh_token.trim().is_empty() {
        return Err(format!("refresh OAuth session was rejected; run {app_name} login"));
    }
    save_oauth_authorization_token(
        app_name,
        &token.access_token,
        &token.refresh_token,
        &token.token_type,
        &token.scope,
        token.expires_in,
        token.refresh_token_expires_in,
    )?;
    Ok(token.access_token.trim().to_string())
}

fn oauth_authorization_token_path(app_name: &str) -> AppResult<PathBuf> {
    if let Some(path) = env_value("OPENCLI_OAUTH_TOKEN_FILE") {
        return Ok(PathBuf::from(path));
    }
{{- if and (appUsesOAuth2 .App) .RuntimeBundle (eq .RuntimeBundle.OAuth2GrantType "authorization_code") }}
    let auth = load_oauth_authorization_config(app_name)?;
    let identity = format!("{}\n{}\n{}", auth.client_id, auth.authorization_url, auth.token_url);
    let namespace = format!("{:x}", Sha256::digest(identity.as_bytes()));
    let home = dirs::home_dir().ok_or_else(|| "resolve OAuth session directory: home directory is unavailable".to_string())?;
    Ok(home.join(".opencli").join("oauth2").join(namespace).join("oauth-token.json"))
{{- else }}
    let home = env_value("HOME").or_else(|| env_value("USERPROFILE"))
        .ok_or_else(|| "resolve OAuth session directory: home directory is unavailable".to_string())?;
    Ok(PathBuf::from(home).join(".config").join(app_name).join("oauth-token.json"))
{{- end }}
}

#[cfg(unix)]
fn protect_oauth_token_file(path: &Path) -> AppResult<()> {
    use std::os::unix::fs::PermissionsExt;
    fs::set_permissions(path, fs::Permissions::from_mode(0o600)).map_err(|err| format!("protect OAuth session: {err}"))
}

#[cfg(not(unix))]
fn protect_oauth_token_file(_path: &Path) -> AppResult<()> {
    Ok(())
}

fn unix_seconds() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

fn oauth2_aad_context(auth: &RuntimeAuth) -> String {
    [
        auth.grant_type.trim(),
        auth.scheme.trim(),
        auth.token_url.trim(),
        auth.client_id.trim(),
        auth.client_auth.method.trim(),
        auth.client_auth.placement.trim(),
    ].join("|")
}

fn unresolved_credential(auth_mode: &str, header: &str) -> AppResult<(String, Option<String>)> {
    if RUNTIME_CREDENTIAL_REQUIRED {
        Err(missing_credential_error(auth_mode))
    } else {
        Ok((header.to_string(), None))
    }
}

fn missing_credential_error(auth_mode: &str) -> String {
    if auth_mode == "api_key" {
        "missing API key: set OPENCLI_API_KEY or configure runtime auth".to_string()
    } else {
        "missing bearer token: set OPENCLI_AUTH_TOKEN or configure runtime auth".to_string()
    }
}

fn env_value(name: &str) -> Option<String> {
    env::var(name).ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty())
}

fn load_runtime_file(app_name: &str) -> AppResult<Option<(RuntimeFile, PathBuf)>> {
    if let Some(explicit) = env_value("OPENCLI_CONFIG") {
        let path = PathBuf::from(explicit);
        return read_runtime_file(&path).map(|config| Some((config, path)));
    }

	let mut candidates = Vec::new();
	if let Ok(executable) = env::current_exe() {
		if let Some(bin_dir) = executable.parent() {
			if let Some(bundle_root) = bin_dir.parent() {
				candidates.push(bundle_root.join("config").join("runtime.yaml"));
			}
			let profile = bin_dir.file_name().and_then(|value| value.to_str());
			if matches!(profile, Some("debug" | "release")) {
				if let Some(target_dir) = bin_dir.parent() {
					if target_dir.file_name().and_then(|value| value.to_str()) == Some("target") {
						if let Some(project_root) = target_dir.parent() {
							candidates.push(project_root.join("config").join("runtime.yaml"));
						}
					}
				}
			}
		}
	}
    if let Some(root) = env_value("XDG_CONFIG_HOME") {
        candidates.push(PathBuf::from(root).join(app_name).join("config.yaml"));
    } else if let Some(home) = env_value("HOME").or_else(|| env_value("USERPROFILE")) {
        candidates.push(PathBuf::from(home).join(".config").join(app_name).join("config.yaml"));
    }
    for path in candidates {
        match read_runtime_file(&path) {
            Ok(config) => return Ok(Some((config, path))),
            Err(err) if err.starts_with("missing runtime config ") => continue,
            Err(err) => return Err(err),
        }
    }
    Ok(None)
}

fn read_runtime_file(path: &Path) -> AppResult<RuntimeFile> {
    let raw = match fs::read_to_string(path) {
        Ok(raw) => raw,
        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Err(format!("missing runtime config {}", path.display())),
        Err(err) => return Err(format!("read runtime config {}: {err}", path.display())),
    };
    let config: RuntimeFile = serde_yaml::from_str(&raw).map_err(|err| format!("parse runtime config {}: {err}", path.display()))?;
    if !config.version.trim().is_empty() && config.version.trim() != "v1" {
        return Err(format!("parse runtime config {}: version must be v1", path.display()));
    }
    Ok(config)
}

fn decrypt_runtime_value(envelope: &str, auth_type: &str, header: &str) -> AppResult<String> {
    if !HAS_SEALED_RUNTIME_KEY {
        return Err("generated CLI has no sealing key".to_string());
    }
    let encoded = envelope.strip_prefix({{ printf "%q" (runtimeEnvelopePrefix) }}).and_then(|value| value.strip_suffix({{ printf "%q" (runtimeEnvelopeSuffix) }}))
        .ok_or_else(|| "invalid ENC[v1] envelope".to_string())?;
    let payload = URL_SAFE_NO_PAD.decode(encoded).map_err(|err| format!("decode sealed credential: {err}"))?;
    if payload.len() <= 12 {
        return Err("sealed credential payload is too short".to_string());
    }
    let mut key = [0u8; 32];
    for index in 0..key.len() {
        key[index] = KEY_SHARE_A[index] ^ KEY_SHARE_B[index];
    }
    let cipher = Aes256Gcm::new_from_slice(&key).map_err(|err| format!("create credential cipher: {err}"))?;
    let aad = format!("{}{auth_type}:{}", {{ printf "%q" (runtimeAADPrefix) }}, header.trim().to_lowercase());
    let plaintext = cipher.decrypt(Nonce::from_slice(&payload[..12]), Payload { msg: &payload[12..], aad: aad.as_bytes() })
        .map_err(|_| "authenticate sealed credential".to_string())?;
    String::from_utf8(plaintext).map_err(|err| format!("credential is not UTF-8: {err}"))
}
