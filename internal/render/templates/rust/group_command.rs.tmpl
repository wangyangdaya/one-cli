use clap::{Args, Subcommand};
{{- if or (groupUsesMCPHTTP .Group) (groupUsesMCPStdio .Group) }}
use serde_json::{Map, Value};
{{- else if groupHasBodyInput .Group }}
use serde_json::Value;
{{- end }}

use crate::client;
use crate::output;
use crate::types::AppResult;

#[derive(Subcommand)]
pub enum Command {
{{- range .Group.Operations }}
    #[command(name = "{{ .CommandName }}")]
    {{ rustTypeName .CommandName }}({{ rustTypeName .CommandName }}Args),
{{- end }}
}

impl Command {
    pub async fn run(self) -> AppResult<()> {
        match self {
{{- range .Group.Operations }}
            Command::{{ rustTypeName .CommandName }}(args) => run_{{ rustFieldName .CommandName }}(args).await,
{{- end }}
        }
    }
}

{{- range .Group.Operations }}
#[derive(Args)]
pub struct {{ rustTypeName .CommandName }}Args {
{{- range .Parameters }}
{{- if eq .In "path" }}
    #[arg(long = "{{ rustParamFlagName . }}")]
    pub {{ rustParamFieldName . }}: {{ if .Required }}{{ rustType .Type }}{{ else }}Option<{{ rustType .Type }}>{{ end }},
{{- end }}
{{- if eq .In "query" }}
    #[arg(long = "{{ rustParamFlagName . }}")]
    pub {{ rustParamFieldName . }}: {{ if .Required }}{{ rustType .Type }}{{ else }}Option<{{ rustType .Type }}>{{ end }},
{{- end }}
{{- end }}
{{- if operationHasHeaderParams . }}
    #[arg(short = 'H', long = "header")]
    pub header: Vec<String>,
{{- end }}
{{- if .BodyMode }}
    #[arg(long = "data")]
    pub body_data: Option<String>,
{{- end }}
{{- if .FileFields }}
    #[arg(long = "file")]
    pub upload_file: Option<String>,
{{- end }}
{{- range .BodyFields }}
{{- if rustBodyFieldHasFlag . }}
    #[arg(long = "{{ rustBodyFlagName . }}")]
    pub {{ rustBodyFieldName . }}: Option<{{ rustType .Type }}>,
{{- end }}
{{- end }}
}

async fn run_{{ rustFieldName .CommandName }}(args: {{ rustTypeName .CommandName }}Args) -> AppResult<()> {
{{- if .FileFields }}
    if args.body_data.as_deref() == Some("-") && args.upload_file.as_deref() == Some("-") {
        return Err("--data and --file cannot both read from stdin".to_string());
    }
{{- end }}
{{- if groupUsesMCPStdio $.Group }}
    let arguments = build_{{ rustFieldName .CommandName }}_body(&args)?.unwrap_or_else(|| Value::Object(Map::new()));
    let response = client::call_mcp_stdio_tool(
        "{{ $.Group.Command }}",
        &[
{{- range $.Group.Args }}
            "{{ . }}",
{{- end }}
        ],
        &[
{{- range $key, $value := $.Group.Env }}
            ("{{ $key }}", "{{ $value }}"),
{{- end }}
        ],
        "{{ .RemoteName }}",
        arguments,
    ).await?;
{{- else if groupUsesMCPHTTP $.Group }}
    let arguments = build_{{ rustFieldName .CommandName }}_body(&args)?.unwrap_or_else(|| Value::Object(Map::new()));
    let response = client::call_mcp_tool(
        "{{ $.Group.Endpoint }}",
        vec![
{{- range $name, $value := $.Group.Headers }}
            ("{{ $name }}".to_string(), "{{ $value }}".to_string()),
{{- end }}
        ],
        "{{ .RemoteName }}",
        arguments,
    ).await?;
{{- else }}
{{- if operationHasPathParams . }}
    let mut path = String::from("{{ .Path }}");
{{- else }}
    let path = String::from("{{ .Path }}");
{{- end }}
{{- range .Parameters }}
{{- if eq .In "path" }}
    path = path.replace("{{ printf "{%s}" .Name }}", &args.{{ rustParamFieldName . }}.to_string());
{{- end }}
{{- end }}

{{- if operationHasQueryParams . }}
    let mut query = Vec::new();
{{- else }}
    let query = Vec::new();
{{- end }}
{{- range .Parameters }}
{{- if eq .In "query" }}
{{- if .Required }}
    query.push(("{{ .Name }}".to_string(), args.{{ rustParamFieldName . }}.to_string()));
{{- else }}
    if let Some(value) = &args.{{ rustParamFieldName . }} {
        query.push(("{{ .Name }}".to_string(), value.to_string()));
    }
{{- end }}
{{- end }}
{{- end }}

{{- if operationHasHeaderParams . }}
    let headers = client::parse_headers(&args.header)?;
{{- else }}
    let headers = Vec::new();
{{- end }}
    let body = build_{{ rustFieldName .CommandName }}_http_body(&args{{ if .FileFields }}, args.upload_file.is_some(){{ end }})?;
{{- if .FileFields }}
    let response = if let Some(file) = &args.upload_file {
        client::request_multipart("{{ .Method }}", &path, query, headers, file, "{{ defaultFileField . }}", body).await?
    } else {
        client::request_json_text("{{ .Method }}", &path, query, headers, body).await?
    };
{{- else }}
    let response = client::request_json_text("{{ .Method }}", &path, query, headers, body).await?;
{{- end }}
{{- end }}
    output::print_output("{{ $.App.Name }} {{ $.Group.Name }} {{ .CommandName }}", &response)
}

{{- if not (or (groupUsesMCPStdio $.Group) (groupUsesMCPHTTP $.Group)) }}
fn build_{{ rustFieldName .CommandName }}_http_body(args: &{{ rustTypeName .CommandName }}Args{{ if .FileFields }}, allow_empty: bool{{ end }}) -> AppResult<Option<String>> {
{{- if .FileFields }}
    let _ = allow_empty;
{{- end }}
{{- if not .BodyMode }}
    let _ = args;
    Ok(None)
{{- else }}
    if let Some(data) = &args.body_data {
        let content = client::resolve_input(data)?;
        let parsed = serde_json::from_str::<Value>(&content).map_err(|err| err.to_string())?;
        let _ = parsed;
        return Ok(Some(content.trim().to_string()));
    }

{{- if .BodyFields }}
    let mut parts: Vec<String> = Vec::new();
    let mut has_flag_body = false;
{{- range rustBodyFieldsForSigner $.App .BodyFields }}
{{- if rustBodyFieldHasFlag . }}
    if let Some(value) = &args.{{ rustBodyFieldName . }} {
        let value = serde_json::to_string(value).map_err(|err| err.to_string())?;
        parts.push(format!("\"{{ .Name }}\":{value}"));
        has_flag_body = true;
    }
{{- end }}
{{- end }}
{{- if eq .BodyMode "simple-json" }}
    if has_flag_body {
{{- range .BodyFields }}
{{- if rustBodyFieldHasFlag . }}
{{- if .Required }}
        if args.{{ rustBodyFieldName . }}.is_none() {
            return Err("missing required body field: {{ .Name }}".to_string());
        }
{{- end }}
{{- end }}
{{- end }}
        return Ok(Some("{".to_string() + &parts.join(",") + "}"));
    }
{{- else }}
    if has_flag_body {
        return Ok(Some("{".to_string() + &parts.join(",") + "}"));
    }
{{- end }}
{{- end }}
{{- if .BodyRequired }}
{{- if .FileFields }}
    if allow_empty {
        return Ok(None);
    }
{{- end }}
    Err("request body is required".to_string())
{{- else }}
    Ok(None)
{{- end }}
{{- end }}
}

{{- end }}
{{- if or (groupUsesMCPStdio $.Group) (groupUsesMCPHTTP $.Group) }}
fn build_{{ rustFieldName .CommandName }}_body(args: &{{ rustTypeName .CommandName }}Args) -> AppResult<Option<Value>> {
{{- if not .BodyMode }}
    let _ = args;
    Ok(None)
{{- else }}
    if let Some(data) = &args.body_data {
        let content = client::resolve_input(data)?;
        let parsed = serde_json::from_str::<Value>(&content).map_err(|err| err.to_string())?;
        return Ok(Some(parsed));
    }

{{- if .BodyFields }}
    let mut payload = Map::new();
    let mut has_flag_body = false;
{{- range .BodyFields }}
{{- if rustBodyFieldHasFlag . }}
    if let Some(value) = &args.{{ rustBodyFieldName . }} {
        payload.insert("{{ .Name }}".to_string(), serde_json::json!(value));
        has_flag_body = true;
    }
{{- end }}
{{- end }}
{{- if eq .BodyMode "simple-json" }}
    if has_flag_body {
{{- range .BodyFields }}
{{- if rustBodyFieldHasFlag . }}
{{- if .Required }}
        if args.{{ rustBodyFieldName . }}.is_none() {
            return Err("missing required body field: {{ .Name }}".to_string());
        }
{{- end }}
{{- end }}
{{- end }}
        return Ok(Some(Value::Object(payload)));
    }
{{- else }}
    if has_flag_body {
        return Ok(Some(Value::Object(payload)));
    }
{{- end }}
{{- end }}
{{- if .BodyRequired }}
    Err("request body is required".to_string())
{{- else }}
    Ok(None)
{{- end }}
{{- end }}
}
{{- end }}
{{ end -}}
