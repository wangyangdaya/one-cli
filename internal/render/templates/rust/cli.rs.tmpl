use clap::{CommandFactory, Parser, Subcommand};

use crate::commands;
use crate::types::AppResult;

#[derive(Parser)]
#[command(
    name = "{{ .App.Name }}",
    about = "{{ .App.Name }} CLI",
    long_about = r#"{{ .App.Name }} CLI

USAGE:
  {{ .App.Name }} [options] [command]

EXAMPLES:
{{- range $group := .App.Groups }}
{{- with index $group.Operations 0 }}
  {{ $.App.Name }} {{ $group.Name }} {{ .CommandName }}
{{- end }}
{{- end }}"#,
    after_help = "More help: {{ .App.Name }} <command> --help",
    disable_version_flag = true
)]
struct Cli {
    /// Print version information
    #[arg(long)]
    version: bool,

    /// Print HTTP request and response trace logs
    #[arg(long)]
    trace: bool,

    /// Print command output as JSON
    #[arg(long)]
    json: bool,

    /// Request header in 'Name: Value' or 'Name=Value' format; repeatable
    #[arg(short = 'H', long = "header")]
    header: Vec<String>,

    #[command(subcommand)]
    command: Option<GroupCommand>,
}

#[derive(Subcommand)]
enum GroupCommand {
{{- if and (appUsesOAuth2 .App) .RuntimeBundle (eq .RuntimeBundle.OAuth2GrantType "authorization_code") }}
    #[command(name = "login")]
    Login {
        /// Print the authorization URL without opening a browser
        #[arg(long = "no-browser")]
        no_browser: bool,
    },
    #[command(name = "status")]
    Status,
    #[command(name = "logout")]
    Logout,
{{- end }}
    #[command(name = "skills")]
    Skills {
        #[arg(long = "skills-dir", default_value = "skills")]
        skills_dir: String,
        #[command(subcommand)]
        command: SkillsCommand,
    },
{{- range .App.Groups }}
    #[command(name = "{{ .Name }}")]
    {{ rustTypeName (rustModuleName .) }} {
        #[command(subcommand)]
        command: commands::{{ rustModuleName . }}::Command,
    },
{{- end }}
}

#[derive(Subcommand)]
enum SkillsCommand {
    /// List generated skills
    List,
    /// Print a generated skill file
    Read {
        skill: String,
        path: Option<String>,
    },
}

pub async fn run() -> AppResult<()> {
    let cli = Cli::parse();
    if cli.version {
        if cli.json {
            crate::output::set_json_enabled(true);
            let data = serde_json::json!({ "version": version() });
            crate::output::print_output("{{ .App.Name }} version", &data)?;
            return Ok(());
        }
        println!("{{ .App.Name }} version {}", version());
        return Ok(());
    }

    crate::trace::set_enabled(cli.trace);
    crate::output::set_json_enabled(cli.json);
    let headers = crate::client::parse_headers(&cli.header)?;
    crate::client::set_global_headers(headers);
    match cli.command {
{{- if and (appUsesOAuth2 .App) .RuntimeBundle (eq .RuntimeBundle.OAuth2GrantType "authorization_code") }}
        Some(GroupCommand::Login { no_browser }) => crate::oauth_auth::login("{{ .App.Name }}", no_browser).await,
        Some(GroupCommand::Status) => crate::oauth_auth::status("{{ .App.Name }}"),
        Some(GroupCommand::Logout) => crate::oauth_auth::logout("{{ .App.Name }}"),
{{- end }}
        Some(GroupCommand::Skills { skills_dir, command }) => run_skills(command, &skills_dir),
{{- range .App.Groups }}
        Some(GroupCommand::{{ rustTypeName (rustModuleName .) }} { command }) => command.run().await,
{{- end }}
        None => {
            Cli::command().print_help().map_err(|err| err.to_string())?;
            println!();
            Ok(())
        }
    }
}

fn version() -> &'static str {
    env!("CARGO_PKG_VERSION")
}

fn run_skills(command: SkillsCommand, skills_dir: &str) -> AppResult<()> {
    match command {
        SkillsCommand::List => {
            let root = skills_root(skills_dir)?;
            let mut names = Vec::new();
            for entry in std::fs::read_dir(&root).map_err(|err| err.to_string())? {
                let entry = entry.map_err(|err| err.to_string())?;
                if !entry.file_type().map_err(|err| err.to_string())?.is_dir() {
                    continue;
                }
                let name = entry.file_name().to_string_lossy().to_string();
                if entry.path().join("SKILL.md").is_file() {
                    names.push(name);
                }
            }
            names.sort();
            for name in names {
                let desc = skill_description(&root.join(&name).join("SKILL.md"));
                if desc.is_empty() {
                    println!("{name}");
                } else {
                    println!("{name}\t{desc}");
                }
            }
            Ok(())
        }
        SkillsCommand::Read { skill, path } => {
            let root = skills_root(skills_dir)?;
            let path = safe_skill_path(&root, &skill, path.as_deref().unwrap_or("SKILL.md"))?;
            let content = std::fs::read_to_string(path).map_err(|err| err.to_string())?;
            print!("{content}");
            Ok(())
        }
    }
}

fn skills_root(dir: &str) -> AppResult<std::path::PathBuf> {
    let root = if dir.trim().is_empty() { "skills" } else { dir.trim() };
    let path = std::path::PathBuf::from(root);
    if path.is_dir() {
        return Ok(path);
    }
    Err(format!("skills directory {root:?} not found; run from the generated project root or pass --skills-dir"))
}

fn safe_skill_path(root: &std::path::Path, skill: &str, rel: &str) -> AppResult<std::path::PathBuf> {
    if skill.is_empty() || skill.contains('/') || skill.contains('\\') {
        return Err(format!("invalid skill {skill:?}"));
    }
    let rel_path = std::path::Path::new(rel);
    if rel_path.as_os_str().is_empty() || rel_path.is_absolute() {
        return Err(format!("invalid skill file path {rel:?}"));
    }
    for component in rel_path.components() {
        match component {
            std::path::Component::Normal(_) => {}
            _ => return Err(format!("invalid skill file path {rel:?}")),
        }
    }
    let base = root.join(skill);
    if !base.join("SKILL.md").is_file() {
        return Err(format!("unknown skill {skill:?}"));
    }
    Ok(base.join(rel_path))
}

fn skill_description(path: &std::path::Path) -> String {
    // Best-effort single-line description extraction. Generated SKILL.md always
    // emits `description: "..."` as a single-line double-quoted string. Manual
    // multi-line YAML (folded `>` or block `|`) is not supported here; keep
    // descriptions single-line for correct `skills list` output.
    let Ok(content) = std::fs::read_to_string(path) else {
        return String::new();
    };
    let mut lines = content.lines();
    if lines.next().map(str::trim) != Some("---") {
        return String::new();
    }
    for line in lines {
        let line = line.trim();
        if line == "---" {
            return String::new();
        }
        if let Some(value) = line.strip_prefix("description:") {
            return value.trim().trim_matches('"').to_string();
        }
    }
    String::new()
}
