# OpenAI-compatible LLM API base URL used by the verifier agent.
LLM_BASE_URL=https://api.openai.com/v1

# API key for the verifier agent's LLM provider.
LLM_API_KEY=replace-me

# Model name used by the verifier agent.
LLM_MODEL_NAME=gpt-4o-mini

# Generated CLI project directory, relative to the repository root or absolute.
SKILLS_VERIFY_APP_DIR=tmp/openapi

# Comma-separated executable allow-list; only these CLI names may be run.
ALLOWED_EXECUTABLES=openapi-cli

# Default base URL injected into generated CLIs as OPENCLI_BASE_URL.
OPENCLI_BASE_URL=https://api.example.com

# Optional bearer token for generated token-auth CLIs.
OPENCLI_AUTH_TOKEN=

# Optional AK/SK access key for generated AK/SK CLIs.
OPENCLI_AK=

# Optional AK/SK secret key for generated AK/SK CLIs.
OPENCLI_SK=

# Optional per-executable base URL map, e.g. supplier-cli=https://ediuat.mychery.com/prod-api,petcli=https://pet.example.com.
OPENCLI_BASE_URL_MAP=

# Verifier log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
